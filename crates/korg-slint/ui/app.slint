import { Button, CheckBox, LineEdit, ScrollView, Slider, TabWidget } from "std-widgets.slint";

component SpinArrow inherits Rectangle {
    in property <image> icon;
    in property <bool> enabled: true;
    callback clicked();

    width: 13px;
    height: 100%;
    background: touch.pressed ? #4a4a4a : transparent;
    border-radius: 3px;

    Image {
        source: root.icon;
        width: 8px;
        height: 8px;
        colorize: root.enabled ? #f0f0f0 : #787878;
        image-fit: contain;
    }
    touch := TouchArea { enabled: root.enabled; clicked => { root.clicked(); } }
}

// Compact integer spinner: value field with small stacked arrows, replacing
// std SpinBox whose arrow buttons take a third of its width.  Same interface
// (value, minimum, maximum, edited), plus wheel and Up/Down keys.
component CompactSpin inherits Rectangle {
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in-out property <int> value: 0;
    callback edited(int);

    height: 26px;
    width: 92px;
    background: #3a3a3a;
    border-radius: 4px;
    border-width: 1px;
    border-color: field.has-focus ? #8a8a8a : #5a5a5a;

    function commit(number: int) {
        root.value = Math.max(root.minimum, Math.min(root.maximum, number));
        field.text = root.value;
        root.edited(root.value);
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 1px;
        spacing: 2px;
        Rectangle {
            clip: true;
            horizontal-stretch: 1;
            TouchArea {
                scroll-event(event) => {
                    if event.delta-y > 0 { root.commit(root.value + 1); return accept; }
                    if event.delta-y < 0 { root.commit(root.value - 1); return accept; }
                    reject
                }
            }
            field := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                color: #ffffff;
                font-size: 13px;
                selection-background-color: #5a5a5a;
                text: root.value;
                key-pressed(event) => {
                    if event.text == Key.UpArrow { root.commit(root.value + 1); return accept; }
                    if event.text == Key.DownArrow { root.commit(root.value - 1); return accept; }
                    reject
                }
                accepted => {
                    if self.text.is-float() {
                        root.commit(Math.round(self.text.to-float()));
                    } else {
                        self.text = root.value;
                    }
                }
            }
        }
        VerticalLayout {
            width: 13px;
            padding-top: 2px;
            padding-bottom: 2px;
            up := Rectangle {
                background: up-touch.pressed ? #4a4a4a : transparent;
                border-radius: 2px;
                Image {
                    source: @image-url("icons/chevron-up.svg");
                    width: 8px;
                    height: 8px;
                    colorize: root.value < root.maximum ? #e0e0e0 : #707070;
                    image-fit: contain;
                }
                up-touch := TouchArea { clicked => { root.commit(root.value + 1); } }
            }
            down := Rectangle {
                background: down-touch.pressed ? #4a4a4a : transparent;
                border-radius: 2px;
                Image {
                    source: @image-url("icons/chevron-down.svg");
                    width: 8px;
                    height: 8px;
                    colorize: root.value > root.minimum ? #e0e0e0 : #707070;
                    image-fit: contain;
                }
                down-touch := TouchArea { clicked => { root.commit(root.value - 1); } }
            }
        }
    }
}

// Compact drop-down: the same box as CompactSpin with one small chevron and a
// popup list.  Same interface as the std ComboBox it replaces (model,
// current-index, enabled, current-value, selected), so the call sites are
// unchanged.
component CompactCombo inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: 0;
    in property <bool> enabled: true;
    out property <string> current-value: (root.current-index >= 0 && root.current-index < root.model.length) ? root.model[root.current-index] : "";
    callback selected(string);
    callback selected-index(int);

    height: 26px;
    width: 130px;
    background: #3a3a3a;
    border-radius: 4px;
    border-width: 1px;
    border-color: field.has-focus ? #8a8a8a : #5a5a5a;
    forward-focus: field;

    function toggle() {
        if (!root.enabled) { return; }
        if (popup.is-open) { popup.close(); } else { popup.show(); }
    }

    function select(index: int) {
        if (index < 0 || index >= root.model.length) { return; }
        root.current-index = index;
        root.selected(root.model[index]);
        root.selected-index(index);
    }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 1px;
        spacing: 2px;
        Rectangle {
            clip: true;
            horizontal-stretch: 1;
            body-touch := TouchArea {
                enabled: root.enabled;
                clicked => { field.focus(); root.toggle(); }
            }
            field := FocusScope {
                width: 100%;
                height: 100%;
                key-pressed(event) => {
                    if (!root.enabled) { return reject; }
                    if (event.text == Key.UpArrow) {
                        root.select(root.current-index - 1);
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.select(root.current-index + 1);
                        return accept;
                    }
                    if (event.text == Key.Return || event.text == Key.Space) {
                        root.toggle();
                        return accept;
                    }
                    if (event.text == Key.Escape && popup.is-open) {
                        popup.close();
                        return accept;
                    }
                    return reject;
                }

                Text {
                    width: 100%;
                    height: 100%;
                    vertical-alignment: center;
                    color: root.enabled ? #ffffff : #707070;
                    font-size: 13px;
                    text: root.current-value;
                    overflow: elide;
                }
            }
        }
        Rectangle {
            width: 13px;
            background: chevron-touch.pressed ? #4a4a4a : transparent;
            border-radius: 2px;
            Image {
                source: @image-url("icons/chevron-down.svg");
                width: 8px;
                height: 8px;
                colorize: root.enabled ? #e0e0e0 : #707070;
                image-fit: contain;
            }
            chevron-touch := TouchArea {
                enabled: root.enabled;
                clicked => { field.focus(); root.toggle(); }
            }
        }
    }

    popup := PopupWindow {
        x: 0;
        y: root.height;
        width: max(root.width, 160px);
        height: min(root.model.length, 12) * 22px + 8px;
        close-policy: close-on-click-outside;
        forward-focus: popup-focus;

        popup-focus := FocusScope {
            key-pressed(event) => {
                if (event.text == Key.UpArrow) {
                    root.select(root.current-index - 1);
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    root.select(root.current-index + 1);
                    return accept;
                }
                if (event.text == Key.Return || event.text == Key.Escape) {
                    popup.close();
                    return accept;
                }
                return reject;
            }

            Rectangle {
                background: #2f2f2f;
                border-radius: 4px;
                border-width: 1px;
                border-color: #5a5a5a;

                ScrollView {
                    VerticalLayout {
                        padding: 4px;
                        spacing: 0px;

                        for value[index] in root.model : Rectangle {
                            height: 22px;
                            border-radius: 3px;
                            background: index == root.current-index ? #4a4a4a : (item-touch.has-hover ? #3a3a3a : transparent);
                            Text {
                                x: 8px;
                                width: parent.width - 16px;
                                height: 100%;
                                vertical-alignment: center;
                                color: #ffffff;
                                font-size: 13px;
                                text: value;
                                overflow: elide;
                            }
                            item-touch := TouchArea {
                                clicked => {
                                    root.select(index);
                                    popup.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

component BpmSpinBox inherits Rectangle {
    in property <int> value: 1200;
    in property <int> minimum: 200;
    in property <int> maximum: 3000;
    callback changed(int);

    height: 26px;
    width: 104px;
    background: #3a3a3a;
    border-radius: 4px;
    border-width: 1px;
    border-color: #5a5a5a;

    in-out property <int> current: root.value;
    changed value => { root.current = root.value; field.text = root.format(root.value); }

    function format(number: int) -> string {
        return Math.floor(number / 10) + "." + Math.abs(Math.mod(number, 10));
    }

    function commit(number: int) {
        root.current = Math.max(root.minimum, Math.min(root.maximum, number));
        field.text = root.format(root.current);
        root.changed(root.current);
    }

    function bump(delta: int) {
        root.commit(root.current + delta);
    }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 2px;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: 4px;

        Rectangle {
            clip: true;
            horizontal-stretch: 1;
            TouchArea {
                scroll-event(event) => {
                    if event.delta-y > 0 {
                        root.bump(10);
                        return accept;
                    }
                    if event.delta-y < 0 {
                        root.bump(-10);
                        return accept;
                    }
                    reject
                }
            }
            field := TextInput {
                width: 100%;
                height: 100%;
                vertical-alignment: center;
                horizontal-alignment: left;
                color: #ffffff;
                selection-background-color: #5a5a5a;
                selection-foreground-color: #ffffff;
                text: "120.0";
                accessible-role: text-input;

                init => { self.text = root.format(root.current); }

                key-pressed(event) => {
                    if event.text == Key.UpArrow {
                        root.bump(10);
                        return accept;
                    }
                    if event.text == Key.DownArrow {
                        root.bump(-10);
                        return accept;
                    }
                    reject
                }

                edited => { }
                accepted => {
                    if self.text.is-float() {
                        root.commit(Math.round(self.text.to-float() * 10));
                    } else {
                        self.text = root.format(root.current);
                    }
                }
            }
        }
        SpinArrow {
            icon: @image-url("icons/chevron-up.svg");
            enabled: root.current < root.maximum;
            clicked => { root.bump(10); }
        }
        SpinArrow {
            icon: @image-url("icons/chevron-down.svg");
            enabled: root.current > root.minimum;
            clicked => { root.bump(-10); }
        }
    }
}

export struct SceneTab {
    index: int,
    label: string,
}

export struct GlobalChoiceList {
    labels: [string],
    selected: int,
}

export struct ParamRow {
    element: int,
    // Schema parameter index, or -1 for rows that are not schema rows.
    index: int,
    offset: int,
    byte-offset: int,
    key: string,
    label: string,
    value: int,
    minimum: int,
    maximum: int,
    // 0 number, 1 choice, 2 block heading, 3 text.
    kind: int,
    choices: [string],
    display: string,
    hint: string,
}

export struct ParamBlock {
    title: string,
    rows: [ParamRow],
}

export struct BrowseFile {
    label: string,
    path: string,
}

export struct TreeChip {
    index: int,
    label: string,
    selected: bool,
    color: color,
    tooltip: string,
}

export struct ControlTreeRow {
    header: bool,
    label: string,
    count: int,
    open: bool,
    selected: bool,
    contains: bool,
    index: int,
    nested: bool,
    color: color,
    tooltip: string,
    chips: [TreeChip],
}

export struct PanelControl {
    index: int,
    label: string,
    group: string,
    x: float,
    y: float,
    w: float,
    h: float,
    selected: bool,
    value: string,
    badge: string,
    axis-x: string,
    axis-y: string,
    pad-touch: string,
    tooltip: string,
    // The legend colour of the message the control sends (Note, CC, PC,
    // none); fills the value badge of the selected control.
    message-color: color,
    // The control just sent a message (MIDI monitor).
    lit: bool,
}

// One line of the MIDI monitor.
export struct MonitorRow {
    time: string,
    text: string,
    hex: string,
    color: color,
}

export struct DevicePort {
    kind: string,
    name: string,
}

export struct DeviceCard {
    class: string,
    name: string,
    detail: string,
    image: image,
    has-image: bool,
    connected: bool,
    ports: [DevicePort],
    enabled: bool,
}

component DeviceSelect inherits Rectangle {
    in property <[DeviceCard]> devices;
    in property <int> total-devices: 0;
    in-out property <int> device-view: 1;
    in-out property <string> search-text: "";
    in property <string> status: "";
    callback open-device(string);
    callback open-file();
    callback device-view-changed(int);
    callback search-changed(string);
    callback rescan();
    in property <string> midi-backend-label: "MIDI";
    in property <string> midi-backend-note: "";
    in property <bool> midi-backend-enabled: false;
    callback midi-backend-switch();
    callback detect();

    VerticalLayout {
        padding: 16px;
        spacing: 12px;

        HorizontalLayout {
            spacing: 10px;
            Text {
                text: "KORG Kontrol Editor";
                font-size: 22px;
                font-weight: 700;
            }
            Text {
                text: "Select target device";
                font-size: 16px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
        }
        HorizontalLayout {
            spacing: 10px;
            LineEdit {
                width: 250px;
                placeholder-text: "Search name, class or port";
                text: root.search-text;
                edited(text) => { root.search-changed(text); }
            }
            Rectangle {
                height: 32px;
                border-radius: 6px;
                background: #2b2b2b;
                border-width: 1px;
                border-color: #4a4a4a;
                HorizontalLayout {
                    spacing: 0px;
                    Rectangle {
                        width: 100px;
                        background: root.device-view == 0 ? #4a6fa5 : transparent;
                        border-radius: 5px;
                        Text { text: "Connected"; color: #f0f0f0; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.device-view-changed(0); } }
                    }
                    Rectangle {
                        width: 100px;
                        background: root.device-view == 1 ? #4a6fa5 : transparent;
                        border-radius: 5px;
                        Text { text: "All devices"; color: #f0f0f0; horizontal-alignment: center; vertical-alignment: center; }
                        TouchArea { clicked => { root.device-view-changed(1); } }
                    }
                }
            }
            Button { text: "Refresh"; clicked => { root.rescan(); } }
            Button {
                text: root.midi-backend-label;
                enabled: root.midi-backend-enabled;
                clicked => { root.midi-backend-switch(); }
                if root.midi-backend-note != "" : Tooltip { text: @markdown("\{root.midi-backend-note}"); }
            }
            Button {
                text: "Detect";
                clicked => { root.detect(); }
                Tooltip { text: @markdown("Ask every MIDI port which KORG device answers: finds renamed ports and reads the firmware."); }
            }
            Button {
                text: "Open file...";
                clicked => { root.open-file(); }
            }
        }

        if root.device-view == 0 && root.devices.length == 0 : Rectangle {
            height: 150px;
            background: #fff4e5;
            border-radius: 6px;
            border-width: 1px;
            border-color: #e0b070;
            VerticalLayout {
                alignment: center;
                spacing: 8px;
                Text {
                    text: "No connected device found. Offline editing works without a cable.";
                    horizontal-alignment: center;
                    color: #5a3a00;
                }
                Button {
                    text: "Show all devices";
                    clicked => { root.device-view-changed(1); }
                }
            }
        }

        ScrollView {
            GridLayout {
                spacing: 12px;
                for card[index] in root.devices : Rectangle {
                    row: index / 3;
                    col: Math.mod(index, 3);
                    width: 280px;
                    height: 300px;
                    background: #2b2b2b;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #4a4a4a;

                    if !card.connected : Tooltip {
                        text: @markdown("Offline device: editing and Save As work without a cable.");
                    }
                    VerticalLayout {
                        padding: 8px;
                        spacing: 6px;

                        Rectangle {
                            height: card.has-image ? 140px : 0px;
                            background: #a0a4a8;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #6f7479;
                            clip: true;
                            Image {
                                source: card.image;
                                visible: card.has-image;
                                image-fit: contain;
                            }
                            Text {
                                text: card.name;
                                visible: !card.has-image;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                color: #f0f0f0;
                            }
                            TouchArea {
                                clicked => {
                                    if (card.enabled) {
                                        root.open-device(card.class);
                                    }
                                }
                            }
                        }
                        Text {
                            text: card.name;
                            font-size: 15px;
                            font-weight: 600;
                            color: #f0f0f0;
                        }
                        Text {
                            text: card.detail;
                            width: 100%;
                            overflow: elide;
                            font-size: 11px;
                            color: #b8b8b8;
                        }
                        for port in card.ports : Rectangle {
                            height: 20px;
                            HorizontalLayout {
                                spacing: 4px;
                                Text {
                                    text: port.kind;
                                    width: 78px;
                                    font-size: 10px;
                                    color: #8fc7ff;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: port.name;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    font-size: 10px;
                                    color: #d8d8d8;
                                    vertical-alignment: center;
                                }
                            }
                            Tooltip { text: @markdown("\{port.name}"); }
                        }
                        HorizontalLayout {
                            Text {
                                text: card.connected ? "connected" : "not connected";
                                color: card.connected ? #6fcf7f : #a8a8a8;
                                font-size: 11px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }
                }
            }
        }

        Text {
            text: (root.devices.length == root.total-devices
                ? "\{root.devices.length} device(s)"
                : "\{root.devices.length} of \{root.total-devices} device(s)")
                + (root.status != "" ? " · " + root.status : "");
            color: #555555;
        }
    }
}

component PanelCanvas inherits Rectangle {
    in property <[PanelControl]> controls;
    in property <float> panel-width: 550;
    in property <float> panel-height: 329;
    in property <image> panel-image;
    in property <bool> panel-has-image: false;
    in property <bool> show-values: false;
    callback control-clicked(int);

    property <float> scale: Math.min(root.width / (root.panel-width * 1px), root.height / (root.panel-height * 1px));
    property <length> ox: (root.width - root.panel-width * root.scale * 1px) / 2;
    property <length> oy: (root.height - root.panel-height * root.scale * 1px) / 2;
    width: 100%;
    height: 100%;
    background: #2b2b2b;
    border-radius: 8px;

    Image {
        source: root.panel-image;
        visible: root.panel-has-image;
        x: root.ox;
        y: root.oy;
        width: root.panel-width * root.scale * 1px;
        height: root.panel-height * root.scale * 1px;
        image-fit: contain;
    }

    for control in controls : Rectangle {
        x: root.ox + control.x * root.scale * 1px;
        y: root.oy + control.y * root.scale * 1px;
        width: control.w * root.scale * 1px;
        height: control.h * root.scale * 1px;
        background: control.selected ? #c8a00050 : transparent;
        border-color: control.selected ? #e0c000 : transparent;
        border-width: control.selected ? 1px : 0px;
        border-radius: 3px;
        if control.lit : Rectangle {
            background: #ff9f4366;
            border-color: #ff9f43;
            border-width: 2px;
            border-radius: 3px;
        }
        if root.show-values && control.axis-x != "" : Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height - self.height - 2px;
            width: Math.min(parent.width - 4px, 44px);
            height: Math.max(14px, 16px * root.scale);
            background: control.selected ? control.message-color : #101010cc;
            border-radius: 3px;
            border-width: 1px;
            border-color: control.selected ? control.message-color : #ffffff60;
            Text { text: control.axis-x; font-size: 10px; color: control.selected ? #101010 : #ffffff; horizontal-alignment: center; vertical-alignment: center; }
        }
        if root.show-values && control.axis-y != "" : Rectangle {
            x: parent.width - self.width - 2px;
            y: (parent.height - self.height) / 2;
            width: Math.max(20px, 24px * root.scale);
            height: Math.max(22px, 26px * root.scale);
            background: control.selected ? control.message-color : #101010cc;
            border-radius: 3px;
            border-width: 1px;
            border-color: control.selected ? control.message-color : #ffffff60;
            VerticalLayout {
                Text { text: "CC"; font-size: 9px; color: control.selected ? #101010 : #ffffff; horizontal-alignment: center; }
                Text { text: control.axis-y; font-size: 9px; color: control.selected ? #101010 : #ffffff; horizontal-alignment: center; }
            }
        }
        if root.show-values && control.pad-touch != "" : Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: Math.max(24px, 30px * root.scale);
            height: Math.max(14px, 16px * root.scale);
            background: control.selected ? control.message-color : #101010cc;
            border-radius: 3px;
            border-width: 1px;
            border-color: control.selected ? control.message-color : #ffffff60;
            Text { text: control.pad-touch; font-size: 10px; color: control.selected ? #101010 : #ffffff; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        if root.show-values && control.axis-x == "" && control.value != "" && control.w * root.scale * 1px >= 40px : Rectangle {
            x: 0px;
            y: (parent.height - self.height) / 2;
            width: parent.width;
            height: Math.min(parent.height, Math.max(14px, 18px * root.scale));
            background: control.selected ? control.message-color : #101010cc;
            border-radius: 3px;
            border-width: 1px;
            border-color: control.selected ? control.message-color : #ffffff60;
            clip: true;
            Text {
                width: 100%;
                height: 100%;
                text: control.badge;
                font-size: control.w * root.scale * 1px < 26px ? 9px : Math.max(10px, 11px * root.scale);
                color: control.selected ? #101010 : #ffffff;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        if root.show-values && control.axis-x == "" && control.value != "" && control.w * root.scale * 1px < 40px : Rectangle {
            x: (parent.width - self.width) / 2;
            y: parent.height + 1px;
            width: Math.max(34px, 28px * root.scale);
            height: 14px;
            background: control.selected ? control.message-color : #101010cc;
            border-radius: 3px;
            border-width: 1px;
            border-color: control.selected ? control.message-color : #ffffff60;
            clip: true;
            Text { width: 100%; height: 100%; text: control.badge; font-size: 9px; color: control.selected ? #101010 : #ffffff; horizontal-alignment: center; vertical-alignment: center; overflow: elide; }
        }
        if !root.show-values : Tooltip {
            text: @markdown("\{control.tooltip}");
        }
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.control-clicked(control.index); }
        }
    }
}

component Editor inherits Rectangle {
    in property <string> device-name: "No device";
    in property <bool> dirty: false;
    in property <bool> offline: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> can-revert: false;
    in property <bool> monitor-visible: false;
    in property <[MonitorRow]> monitor-rows;
    in property <string> monitor-title: "";
    in property <[SceneTab]> scenes;
    in property <int> scene-index: 0;
    private property <string> receive-tip: "Receive “" + root.selected-scene-name + "” from device" + (root.offline ? " · offline" : "");
    private property <string> write-tip: "Write “" + root.selected-scene-name + "” to device" + (root.offline ? " · offline" : "");
    private property <string> selected-scene-name: root.scenes.length > 0
        ? root.scenes[Math.max(0, Math.min(root.scene-index, root.scenes.length - 1))].label
        : "";
    in property <[ParamRow]> params;
    in property <[ParamRow]> global-params;
    in property <[ParamBlock]> param-blocks;
    in property <string> status: "";
    in property <bool> transfer-enabled: false;
    in property <bool> transfer-busy: false;
    in property <bool> confirm-write-visible: false;
    in property <bool> confirm-global-write-visible: false;
    in property <int> tab: 0;
    in property <[BrowseFile]> browse-files;
    in-out property <string> browse-path: "";
    in property <string> port-name: "";
    in property <[string]> port-in-options;
    in property <int> port-in-index: -1;
    in property <[string]> port-out-options;
    in property <int> port-out-index: -1;
    in property <[string]> link-options;
    in property <int> link-index: -1;
    in property <int> global-length: 0;
    in property <[int]> global-bytes;
    in property <[int]> global-binding-offsets;
    in property <[GlobalChoiceList]> global-choice-lists;
    in property <string> global-channel: "1";
    in property <string> global-controller: "Native";
    in property <string> global-battery: "Alkaline";
    in property <string> global-name: "";
    in property <string> global-clock: "Auto";
    in property <string> global-bpm: "";
    in property <string> global-class: "";
    in property <int> global-tab: 0;
    in property <int> global-channel-value: 1;
    in property <int> global-clock-index: 0;
    in property <int> global-bpm-value: 1200;
    in property <int> global-battery-index: 0;
    in property <int> global-scrub-index: 0;
    in property <string> global-name-text: "";
    in property <int> global-mode-index: 0;
    in property <int> global-key-curve: 0;
    in property <int> global-pad-curve: 0;
    in property <int> global-touch-curve: 0;
    in property <bool> warn-before-write: true;
    in property <bool> auto-receive: false;
    in property <bool> can-calibrate: false;
    in property <bool> show-values: false;
    in property <bool> panel-visible: false;
    in property <[PanelControl]> panel-controls;
    in property <[ControlTreeRow]> control-tree;
    in property <bool> wireless-on;
    in property <string> wireless-how;
    in property <string> wireless-note;
    in property <int> device-scene: -1;
    in property <string> control-details;
    in property <float> panel-width: 550;
    in property <float> panel-height: 329;
    in property <image> panel-image;
    in property <bool> panel-has-image: false;
    function gb(offset: int) -> int { return offset >= 0 && root.global-bytes.length > offset ? root.global-bytes[offset] : 0; }
    function goff(role: int) -> int { return role >= 0 && root.global-binding-offsets.length > role ? root.global-binding-offsets[role] : -1; }
    in property <int> control-index: 0;
    in property <string> control-label: "";

    callback show-devices();
    callback open-file();
    callback new-document();
    callback save-file();
    callback save-as();
    callback save-sysex();
    callback undo();
    callback redo();
    callback revert();
    callback monitor-changed(bool);
    callback clear-monitor();
    callback scene-selected(int);
    callback set-param(int, int, int);
    callback set-param-byte(int, int);
    callback set-param-text(int, string);
    callback set-global-param(int, int, int);
    callback set-global-param-label(int, int, string);
    callback set-param-choice(int, string);
    callback set-param-label(int, int, string);
    callback receive-data();
    callback write-data();
    callback cancel-transfer();
    callback confirm-write();
    callback cancel-write();
    callback control-selected(int);
    callback group-toggled(string);
    callback warn-changed(bool);
    callback auto-receive-changed(bool);
    callback calibrate();
    callback about();
    callback values-changed(bool);
    callback tab-selected(int);
    callback port-in-changed(string);
    callback port-out-changed(string);
    callback link-changed(string);
    in property <string> midi-backend-label: "MIDI";
    in property <string> midi-backend-note: "";
    in property <bool> midi-backend-enabled: false;
    callback midi-backend-switch();
    callback receive-global();
    callback global-tab-selected(int);
    callback set-global-byte(int, int);
    callback set-global-choice(int, int);
    callback set-global-text(int, string);
    callback set-global-bpm(int);
    callback write-global();
    callback confirm-global-write();
    callback cancel-global-write();
    callback open-factory(string);
    callback copy-scene();
    callback cut-scene();
    callback paste-scene();
    callback clear-scene();
    callback receive-scene-data();
    callback write-scene-data();

    VerticalLayout {
        padding: 12px;
        spacing: 8px;


        HorizontalLayout {
            height: 32px;
            spacing: 8px;
            Button {
                text: "Devices";
                clicked => { root.show-devices(); }
            }
            Text {
                text: root.device-name;
                font-size: 16px;
                font-weight: 600;
                vertical-alignment: center;
            }
            Text {
                text: root.dirty ? "modified" : "";
                color: #c0392b;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Button { text: "New"; clicked => { root.new-document(); } }
            Button { text: "Open"; clicked => { root.open-file(); } }
            Button {
                text: "Save";
                enabled: root.dirty;
                clicked => { root.save-file(); }
            }
            Button {
                text: "Save As";
                enabled: root.dirty || root.device-name != "";
                clicked => { root.save-as(); }
            }
            Button {
                text: "Dump";
                enabled: root.dirty;
                clicked => { root.save-sysex(); }
            }
            Button {
                text: "Undo";
                enabled: root.can-undo;
                clicked => { root.undo(); }
            }
            Button {
                text: "Redo";
                enabled: root.can-redo;
                clicked => { root.redo(); }
            }
            Button {
                text: "Revert";
                enabled: root.can-revert;
                clicked => { root.revert(); }
                Tooltip { text: @markdown("Put back the data last received from the device (one undo step)."); }
            }
            Button { text: "About"; clicked => { root.about(); } }
        }

        HorizontalLayout {
            height: 30px;
            spacing: 8px;
            warn-toggle := CheckBox {
                text: "Warn";
                checked: root.warn-before-write;
                toggled => { root.warn-changed(warn-toggle.checked); }
            }
            auto-toggle := CheckBox {
                text: "Auto recv";
                checked: root.auto-receive;
                toggled => { root.auto-receive-changed(auto-toggle.checked); }
            }
            values-toggle := CheckBox {
                text: "Values";
                checked: root.show-values;
                toggled => { root.values-changed(values-toggle.checked); }
            }
            monitor-toggle := CheckBox {
                text: "Monitor";
                checked: root.monitor-visible;
                toggled => { root.monitor-changed(monitor-toggle.checked); }
            }
            if root.link-options.length > 1 : CompactCombo {
                width: 112px;
                model: root.link-options;
                current-index: root.link-index;
                selected(label) => { root.link-changed(label); }
            }
            Text { text: "IN"; color: #c8c8c8; vertical-alignment: center; }
            CompactCombo {
                width: 160px;
                model: root.port-in-options;
                current-index: root.port-in-index;
                selected(label) => { root.port-in-changed(label); }
            }
            Text { text: "OUT"; color: #c8c8c8; vertical-alignment: center; }
            CompactCombo {
                width: 160px;
                model: root.port-out-options;
                current-index: root.port-out-index;
                selected(label) => { root.port-out-changed(label); }
            }
            Button {
                text: root.midi-backend-label;
                enabled: root.midi-backend-enabled && !root.transfer-busy;
                clicked => { root.midi-backend-switch(); }
                if root.midi-backend-note != "" : Tooltip { text: @markdown("\{root.midi-backend-note}"); }
            }
            Button {
                text: "Receive";
                enabled: root.transfer-enabled && !root.transfer-busy;
                clicked => { root.receive-data(); }
                if root.offline : Tooltip { text: @markdown("Offline session: connect the device to receive."); }
            }
            Button {
                text: "Write";
                enabled: root.transfer-enabled && !root.transfer-busy;
                clicked => { root.write-data(); }
                if root.offline : Tooltip { text: @markdown("Offline session: connect the device to write."); }
            }
            Button {
                text: "Cancel";
                enabled: root.transfer-busy;
                clicked => { root.cancel-transfer(); }
            }
            Button {
                text: "Calibrate";
                if root.offline : Tooltip { text: @markdown("Offline session: connect the device to calibrate."); }
                enabled: root.can-calibrate && !root.transfer-busy;
                clicked => { root.calibrate(); }
            }
            Rectangle { horizontal-stretch: 1; }
        }

        if root.confirm-write-visible : Rectangle {
            height: 44px;
            background: #fff3cd;
            border-radius: 6px;
            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                Text {
                    text: "Write the current scene to the device?";
                    vertical-alignment: center;
                    color: #5a4a00;
                }
                Button { text: "Write"; clicked => { root.confirm-write(); } }
                Button { text: "Cancel"; clicked => { root.cancel-write(); } }
            }
        }

        if root.confirm-global-write-visible : Rectangle {
            height: 44px;
            background: #fff3cd;
            border-radius: 6px;
            HorizontalLayout {
                padding: 8px;
                spacing: 10px;
                Text {
                    text: "Write the global block to the device?";
                    vertical-alignment: center;
                    color: #5a4a00;
                }
                Button { text: "Write"; clicked => { root.confirm-global-write(); } }
                Button { text: "Cancel"; clicked => { root.cancel-global-write(); } }
            }
        }

        HorizontalLayout {
            height: 30px;
            spacing: 6px;
            for scene in root.scenes : Rectangle {
                width: 92px;
                height: 30px;
                background: root.scene-index == scene.index ? #4a6fa5 : #2b2b2b;
                border-radius: 6px;
                border-width: 1px;
                border-color: root.scene-index == scene.index ? #6f95cf : #4a4a4a;
                if root.device-scene == scene.index : Rectangle {
                    x: parent.width - 12px;
                    y: 4px;
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #6fcf7f;
                }
                if root.device-scene == scene.index : Tooltip { text: @markdown("Active on the device"); }
                Text {
                    text: scene.label;
                    color: #f0f0f0;
                    font-size: 11px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
                TouchArea {
                    clicked => { root.scene-selected(scene.index); }
                }
                ContextMenuArea {
                    Menu {
                        MenuItem {
                            title: "Receive “\{scene.label}” from device";
                            enabled: !root.offline;
                            activated => { root.scene-selected(scene.index); root.receive-scene-data(); }
                        }
                        MenuItem {
                            title: "Write “\{scene.label}” to device…";
                            enabled: !root.offline;
                            activated => { root.scene-selected(scene.index); root.write-scene-data(); }
                        }
                        MenuSeparator {}
                        MenuItem {
                            title: "Copy scene";
                            activated => { root.scene-selected(scene.index); root.copy-scene(); }
                        }
                        MenuItem {
                            title: "Cut scene";
                            activated => { root.scene-selected(scene.index); root.cut-scene(); }
                        }
                        MenuItem {
                            title: "Paste scene";
                            activated => { root.scene-selected(scene.index); root.paste-scene(); }
                        }
                        MenuItem {
                            title: "Clear scene";
                            activated => { root.scene-selected(scene.index); root.clear-scene(); }
                        }
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; }
            Button {
                width: 34px;
                text: "R";
                enabled: root.transfer-enabled && !root.transfer-busy;
                clicked => { root.receive-scene-data(); }
                Tooltip { text: @markdown("\{root.receive-tip}"); }
            }
            Button {
                width: 34px;
                text: "W";
                enabled: root.transfer-enabled && !root.transfer-busy;
                clicked => { root.write-scene-data(); }
                Tooltip { text: @markdown("\{root.write-tip}"); }
            }
        }

        TabWidget {
            vertical-stretch: 1;
            current-index: root.tab;
            changed current-index => { root.tab-selected(self.current-index); }

            Tab {
                title: "BROWSE";
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
            if root.browse-files.length > 0 : Rectangle {
            vertical-stretch: 1;
            min-height: 220px;
            background: #2b2b2b;
            border-radius: 6px;
            VerticalLayout {
            padding: 6px;
            spacing: 4px;
            HorizontalLayout {
            spacing: 6px;
            LineEdit {
            text: root.browse-path;
            edited(text) => { root.browse-path = text; }
            horizontal-stretch: 1;
            }
            Button { text: "Open path"; clicked => { root.open-factory(root.browse-path); } }
            }
            HorizontalLayout {
            spacing: 6px;
            Button { text: "Copy scene"; clicked => { root.copy-scene(); } }
            Button { text: "Cut scene"; clicked => { root.cut-scene(); } }
            Button { text: "Paste scene"; clicked => { root.paste-scene(); } }
            Button { text: "Clear scene"; clicked => { root.clear-scene(); } }
            }
            ScrollView {
            vertical-stretch: 1;
            VerticalLayout {
            spacing: 4px;
            alignment: start;
            for file in root.browse-files : Button {
            text: file.label;
            width: 320px;
            height: 30px;
            clicked => { root.open-factory(file.path); }
            }
            }
            }
            }
            }
                }
            }
            Tab {
                title: "CONTROL";
                VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
            if root.panel-visible : Rectangle {
            vertical-stretch: 1;
            min-height: 220px;
            background: #3a3a3a;
            border-radius: 6px;
            HorizontalLayout {
            padding: 8px;
            padding-bottom: 12px;
            spacing: 10px;
            VerticalLayout {
            spacing: 6px;
            PanelCanvas {
            controls: root.panel-controls;
            panel-width: root.panel-width;
            panel-height: root.panel-height;
            panel-image: root.panel-image;
            panel-has-image: root.panel-has-image;
            show-values: root.show-values;
            control-clicked(index) => { root.control-selected(index); }
            }
            Text {
            text: root.control-details;
            color: #f0e6c8;
            font-size: 12px;
            horizontal-alignment: center;
            overflow: elide;
            }
            }
            // MIDI monitor: what the device sends, newest first.
            if root.monitor-visible : Rectangle {
            width: 340px;
            background: #202020;
            border-radius: 6px;
            clip: true;
            VerticalLayout {
            padding: 6px;
            spacing: 2px;
            HorizontalLayout {
            spacing: 6px;
            Text { text: root.monitor-title; font-size: 11px; font-weight: 600; color: #f0e6c8; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
            Button { text: "Clear"; clicked => { root.clear-monitor(); } }
            }
            Rectangle {
            vertical-stretch: 1;
            clip: true;
            // Newest first: the pane clips at the bottom.
            VerticalLayout {
            alignment: start;
            spacing: 1px;
            if root.monitor-rows.length == 0 : Text { text: "Move a control on the device."; font-size: 11px; color: #8a8a8a; }
            for row in root.monitor-rows : HorizontalLayout {
            spacing: 6px;
            Text { text: row.time; width: 52px; font-size: 10px; color: #8a8a8a; horizontal-alignment: right; }
            Text { text: row.text; width: 150px; font-size: 11px; color: row.color; overflow: elide; }
            Text { text: row.hex; font-size: 10px; color: #8a8a8a; overflow: elide; horizontal-stretch: 1; }
            }
            }
            }
            }
            }
            }
            }
            // Lower band: control tree left, parameters right (same layout as the TUI).
            HorizontalLayout {
            vertical-stretch: 1;
            // Room for the folded nanoKONTROL list (9 rows) plus the legend.
            min-height: 280px;
            spacing: 8px;
            if root.panel-visible : Rectangle {
            width: 196px;
            background: #3a3a3a;
            border-radius: 6px;
            HorizontalLayout {
            padding: 8px;
            ScrollView {
            width: 180px;
            VerticalLayout {
            spacing: 1px;
            alignment: start;
            Text { text: root.control-label; font-weight: 600; font-size: 12px; color: #f0e6c8; overflow: elide; }
            for row in root.control-tree : Rectangle {
            height: 21px;
            background: row.selected ? #c8a00060 : (row.header && row.open) ? #ffffff10 : transparent;
            border-radius: 3px;
            if row.chips.length == 0 : Text {
            x: row.nested ? 22px : 6px;
            width: parent.width - self.x - 4px;
            text: row.header ? (row.open ? "▾ " : "▸ ") + row.label + "  " + row.count : row.label;
            color: row.header ? (row.contains ? #f0d070 : #d0d0d0) : row.color;
            font-weight: row.header && row.contains ? 600 : 400;
            font-size: 12px;
            overflow: elide;
            vertical-alignment: center;
            }
            if row.chips.length == 0 : TouchArea {
            clicked => {
            if (row.header) { root.group-toggled(row.label); } else { root.control-selected(row.index); }
            }
            }
            if row.chips.length == 0 && !row.header && row.tooltip != "" : Tooltip { text: @markdown("\{row.tooltip}"); }
            if row.chips.length > 0 : HorizontalLayout {
            padding-left: 18px;
            spacing: 2px;
            alignment: start;
            for chip in row.chips : Rectangle {
            width: chip-text.preferred-width + 8px;
            background: chip.selected ? #c8a000 : #ffffff0c;
            border-radius: 3px;
            chip-text := Text {
            text: chip.label;
            color: chip.selected ? #1a1a1a : chip.color;
            font-size: 12px;
            font-weight: chip.selected ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            }
            TouchArea { clicked => { root.control-selected(chip.index); } }
            Tooltip { text: @markdown("\{chip.tooltip}"); }
            }
            }
            }
            Rectangle { height: 6px; }
            HorizontalLayout {
            spacing: 8px;
            Text { text: "Note"; font-size: 10px; color: #7cd98a; }
            Text { text: "CC"; font-size: 10px; color: #7fb8ff; }
            Text { text: "PC"; font-size: 10px; color: #ffb05c; }
            Text { text: "none"; font-size: 10px; color: #808080; }
            }
            }
            }
            }
            }
            Rectangle {
            vertical-stretch: 1;
            background: #2b2b2b;
            border-radius: 6px;

            ScrollView {
            VerticalLayout {
            padding: 10px;
            spacing: 6px;

            FlexboxLayout {
            spacing: 18px;
            for block in root.param-blocks : VerticalLayout {
            width: 380px;
            spacing: 6px;
            alignment: start;
            if block.title != "" : Text {
            text: block.title;
            font-weight: 600;
            color: #c8c8c8;
            horizontal-alignment: left;
            }
            for row in block.rows : VerticalLayout {
            spacing: 4px;
            HorizontalLayout {
                        spacing: 10px;
                        Text {
                        text: row.label;
                        width: 140px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        color: #f0f0f0;
                        }
                        if row.kind == 0 && row.value < -1 : Rectangle {
                        width: 130px;
                        height: 30px;
                        background: #2f2f2f;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #4a4a4a;
                        }
                        if row.kind == 0 && row.value == -1 : Rectangle {
                        width: 130px;
                        height: 30px;
                        background: #3a3a3a;
                        border-radius: 4px;
                        border-width: 1px;
                        border-color: #5a5a5a;
                        HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 2px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        spacing: 4px;
                        Rectangle {
                        clip: true;
                        horizontal-stretch: 1;
                        TextInput {
                        width: 100%;
                        height: 100%;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                        color: #ffffff;
                        selection-background-color: #5a5a5a;
                        selection-foreground-color: #ffffff;
                        text: "";
                        accepted => {
                        if self.text.is-float() {
                        root.set-param-byte(row.byte-offset, Math.max(0, Math.min(127, Math.round(self.text.to-float()))));
                        } else {
                        self.text = "";
                        }
                        }
                        }
                        }
                        SpinArrow { icon: @image-url("icons/chevron-up.svg"); clicked => { root.set-param-byte(row.byte-offset, 0); } }
                        SpinArrow { icon: @image-url("icons/chevron-down.svg"); clicked => { root.set-param-byte(row.byte-offset, 0); } }
                        }
                        }
                        if row.kind == 0 && row.value >= 0 : CompactSpin { width: 92px;
                        value: row.value;
                        minimum: row.minimum;
                        maximum: row.maximum;
                        edited => {
                        if row.byte-offset >= 0 {
                        root.set-param-byte(row.byte-offset, self.value);
                        } else {
                        root.set-param(row.element, row.index, self.value);
                        }
                        }
                        }
                        if row.kind == 3 : LineEdit {
                        width: 220px;
                        text: row.display;
                        placeholder-text: row.hint;
                        // Commit on Enter or when focus leaves: a commit rebuilds the
                        // rows, which would drop the focus after every keystroke.
                        accepted(text) => { root.set-param-text(row.byte-offset, text); }
                        changed has-focus => {
                        if !self.has-focus { root.set-param-text(row.byte-offset, self.text); }
                        }
                        }
                        if row.kind == 1 : CompactCombo {
                        width: 130px;
                        model: row.choices.length > 0 ? row.choices : ["Disable", "Enable"];
                        current-index: row.value - row.minimum;
                        selected(label) => {
                        if row.byte-offset >= 0 {
                        root.set-param-choice(row.byte-offset, label);
                        } else {
                        root.set-param-label(row.element, row.index, label);
                        }
                        }
                        }
                        if row.hint != "" : Text {
                        text: row.hint;
                        color: #8a8a8a;
                        font-size: 10px;
                        width: 76px;
                        overflow: elide;
                        vertical-alignment: center;
                        }
            }
                        }
}
            }
            }
            }
            }
            }
                }
            }
            Tab {
                title: "GLOBAL";
                VerticalLayout {
            Rectangle {
            background: transparent;
            VerticalLayout {
            padding: 12px;
            spacing: 6px;
            alignment: start;
            HorizontalLayout {
            spacing: 6px;
            Rectangle { horizontal-stretch: 1; }
            Text { text: "Global data: " + root.global-length + " bytes"; vertical-alignment: center; color: #d8d8d8; }
            Button { text: "Receive Global"; enabled: root.transfer-enabled && !root.transfer-busy; clicked => { root.receive-global(); } }
            Button { text: "Write Global"; enabled: root.transfer-enabled && !root.transfer-busy && root.global-length > 0; clicked => { root.write-global(); } }
            }
            if root.global-class == "X14800" : TabWidget {
                    vertical-stretch: 1;
                    current-index: root.global-tab;
                    changed current-index => { root.global-tab-selected(self.current-index); }
                    Tab {
                    title: "Common";
                    VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    if root.global-class == "X14800" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Global MIDI Channel"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactSpin { width: 92px; minimum: 1; maximum: 16; value: root.global-channel-value; edited => { root.set-global-byte(root.goff(0), self.value - 1); } }
                    }
                    if root.global-class == "X14800" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Wireless Device Name"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    LineEdit { text: root.global-name-text; width: 300px; edited(text) => { root.set-global-text(root.goff(21), text); } }
                    }
                    // Information only: no MIDI message switches wireless (korg_app::wireless).
                    if root.global-class == "X14800" : HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text { text: "Wireless"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CheckBox {
                        text: root.wireless-on ? "On" : "Unknown";
                        checked: root.wireless-on;
                        enabled: false;
                        Tooltip { text: @markdown("\{root.wireless-note}"); }
                    }
                    Text { text: "on device: " + root.wireless-how; color: #a8a8a8; font-size: 11px; vertical-alignment: center; }
                    }
                    if root.global-class == "X14800" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "MIDI Clock Source"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactCombo { width: 130px; model: root.global-choice-lists[2].labels; current-index: root.global-choice-lists[2].selected; selected-index(index) => { root.set-global-choice(2, index); } }
                    Text { text: "BPM"; width: 40px; color: #f0f0f0; vertical-alignment: center; }
                    BpmSpinBox { width: 104px; value: root.global-bpm-value; minimum: 200; maximum: 3000; changed(value) => { root.set-global-bpm(value); } }
                    }
                    if root.global-class == "X14800" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Battery Type"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactCombo { width: 130px; model: root.global-choice-lists[1].labels; current-index: root.global-choice-lists[1].selected; selected-index(index) => { root.set-global-choice(1, index); } }
                    }
                    }
                    }
                    Tab {
                    title: "Controller";
                    VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    if root.global-class == "X14800" : HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                    spacing: 6px;
                    Text { text: "Keyboard"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Velocity Curve"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactCombo { width: 130px; model: root.global-choice-lists[3].labels; current-index: root.global-choice-lists[3].selected; selected-index(index) => { root.set-global-choice(3, index); } }
                    }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Velocity Const Value"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    if root.gb(root.goff(3)) == 5 : CompactSpin { width: 92px; minimum: 1; maximum: 127; value: root.gb(root.goff(4)); edited => { root.set-global-byte(root.goff(4), self.value); } }
                    if root.gb(root.goff(3)) != 5 : Rectangle { width: 130px; height: 30px; background: #3a3a3a; border-radius: 4px; border-width: 1px; border-color: #5a5a5a; }
                    }
                    Text { text: "Trigger Pad"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Velocity Curve"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactCombo { width: 130px; model: root.global-choice-lists[5].labels; current-index: root.global-choice-lists[5].selected; selected-index(index) => { root.set-global-choice(5, index); } }
                    }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Velocity Const Value"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    if root.gb(root.goff(5)) == 5 : CompactSpin { width: 92px; minimum: 1; maximum: 127; value: root.gb(root.goff(6)); edited => { root.set-global-byte(root.goff(6), self.value); } }
                    if root.gb(root.goff(5)) != 5 : Rectangle { width: 130px; height: 30px; background: #3a3a3a; border-radius: 4px; border-width: 1px; border-color: #5a5a5a; }
                    }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Sensitivity"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactSpin { width: 92px; minimum: 1; maximum: 3; value: root.gb(root.goff(7)) + 1; edited => { root.set-global-byte(root.goff(7), self.value - 1); } }
                    }
                    }
                    VerticalLayout {
                    spacing: 6px;
                    Text { text: "Touch Scale"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Note On Velocity"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactSpin { width: 92px; minimum: 0; maximum: 127; value: root.gb(root.goff(8)); edited => { root.set-global-byte(root.goff(8), self.value); } }
                    }
                    Text { text: "Touch Pad Pitch/Mod"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Return Speed"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactCombo { width: 130px; model: root.global-choice-lists[9].labels; current-index: root.global-choice-lists[9].selected; selected-index(index) => { root.set-global-choice(9, index); } }
                    }
                    Text { text: "Chord Octave Offset"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Chord Pad"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    Text { text: "not decoded"; color: #a8a8a8; vertical-alignment: center; }
                    }
                    HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Easy Scale"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    Text { text: "not decoded"; color: #a8a8a8; vertical-alignment: center; }
                    }
                    }
                    }
                    }
                    }
                    Tab {
                    title: "Power Management";
                    VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    if root.global-class == "X14800" : HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                    spacing: 6px;
                    Text { text: "USB"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout { spacing: 10px; Text { text: "Auto LED Off"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[10].labels; current-index: root.global-choice-lists[10].selected; selected-index(index) => { root.set-global-choice(10, index); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Brightness"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactSpin { width: 92px; minimum: 1; maximum: 3; value: root.gb(root.goff(11)) + 1; edited => { root.set-global-byte(root.goff(11), self.value - 1); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Illumination"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[12].labels; current-index: root.global-choice-lists[12].selected; selected-index(index) => { root.set-global-choice(12, index); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Eco Mode"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[13].labels; current-index: root.global-choice-lists[13].selected; selected-index(index) => { root.set-global-choice(13, index); } } }
                    }
                    VerticalLayout {
                    spacing: 6px;
                    Text { text: "Battery"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout { spacing: 10px; Text { text: "Auto Power Off"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[14].labels; current-index: root.global-choice-lists[14].selected; selected-index(index) => { root.set-global-choice(14, index); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "Auto LED Off"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[15].labels; current-index: root.global-choice-lists[15].selected; selected-index(index) => { root.set-global-choice(15, index); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Brightness"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactSpin { width: 92px; minimum: 1; maximum: 3; value: root.gb(root.goff(16)) + 1; edited => { root.set-global-byte(root.goff(16), self.value - 1); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Illumination"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[17].labels; current-index: root.global-choice-lists[17].selected; selected-index(index) => { root.set-global-choice(17, index); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Eco Mode"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[18].labels; current-index: root.global-choice-lists[18].selected; selected-index(index) => { root.set-global-choice(18, index); } } }
                    }
                    }
                    }
                    }
                }
                if root.global-class != "X14800" : TabWidget {
                    vertical-stretch: 1;
                    current-index: root.global-tab == 0 ? 0 : 1;
                    changed current-index => { root.global-tab-selected(self.current-index == 0 ? 0 : 2); }
                    Tab {
                    title: "Common";
                    VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    if root.global-class == "X14802" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Global MIDI Channel"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactSpin { width: 92px; minimum: 1; maximum: 16; value: root.global-channel-value; edited => { root.set-global-byte(root.goff(0), self.value - 1); } }
                    }
                    if root.global-class == "X14802" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Controller Mode"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    // 0 Assignable and 1 Cubase are measured; the rest follow the option order.
                    CompactCombo { width: 160px; model: root.global-choice-lists[19].labels; current-index: root.global-choice-lists[19].selected; selected-index(index) => { root.set-global-choice(19, index); } }
                    }
                    if root.global-class == "X14802" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Battery Type"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactCombo { width: 130px; model: root.global-choice-lists[1].labels; current-index: root.global-choice-lists[1].selected; selected-index(index) => { root.set-global-choice(1, index); } }
                    }
                    if root.global-class == "X14802" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Wireless Device Name"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    LineEdit { text: root.global-name-text; width: 300px; edited(text) => { root.set-global-text(root.goff(21), text); } }
                    }
                    // Information only: no MIDI message switches wireless (korg_app::wireless).
                    if root.global-class == "X14802" : HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    Text { text: "Wireless"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CheckBox {
                        text: root.wireless-on ? "On" : "Unknown";
                        checked: root.wireless-on;
                        enabled: false;
                        Tooltip { text: @markdown("\{root.wireless-note}"); }
                    }
                    Text { text: "on device: " + root.wireless-how; color: #a8a8a8; font-size: 11px; vertical-alignment: center; }
                    }
                    if root.global-class == "X14802" : HorizontalLayout {
                    spacing: 10px;
                    Text { text: "Use Scene Button as Scrub"; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    CompactCombo { width: 130px; model: root.global-choice-lists[20].labels; current-index: root.global-choice-lists[20].selected; selected-index(index) => { root.set-global-choice(20, index); } }
                    }
                    if root.global-class != "X14800" && root.global-class != "X14802" : Text {
                    text: root.global-params.length == 0 ? "No global data is loaded." : "Decoded fields";
                    color: #c8c8c8;
                    }
                    if root.global-class != "X14800" && root.global-class != "X14802" : Rectangle {
                    height: 1px;
                    }
                    if root.global-class != "X14800" && root.global-class != "X14802" : VerticalLayout {
                    for row in root.global-params : HorizontalLayout {
                    spacing: 10px;
                    Text { text: row.label; width: 190px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; }
                    if row.kind == 0 : CompactSpin { width: 92px;
                    minimum: row.minimum;
                    maximum: row.maximum;
                    value: row.value;
                    edited => { root.set-global-param(row.element, row.index, self.value); }
                    }
                    if row.kind == 1 : CompactCombo {
                    model: row.choices;
                    current-index: row.value - row.minimum;
                    selected(label) => { root.set-global-param-label(row.element, row.index, label); }
                    }
                    Text { text: row.display; width: 140px; color: #d8d8d8; vertical-alignment: center; }
                    }
                    }
                    }
                    }
                    Tab {
                    title: "Power Management";
                    VerticalLayout {
                    padding: 16px;
                    spacing: 8px;
                    alignment: start;
                    // Measured 2026-10-21 against the official editor (docs/midi-sysex.md).
                    // Offset 64 is the USB power-off field; the official editor shows no control for it.
                    if root.global-class == "X14802" : HorizontalLayout {
                    spacing: 24px;
                    VerticalLayout {
                    spacing: 6px;
                    Text { text: "USB"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout { spacing: 10px; Text { text: "Auto LED Off"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[10].labels; current-index: root.global-choice-lists[10].selected; selected-index(index) => { root.set-global-choice(10, index); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Brightness"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactSpin { width: 92px; minimum: 1; maximum: 3; value: root.gb(root.goff(11)) + 1; edited => { root.set-global-byte(root.goff(11), self.value - 1); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Illumination"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[12].labels; current-index: root.global-choice-lists[12].selected; selected-index(index) => { root.set-global-choice(12, index); } } }
                    }
                    VerticalLayout {
                    spacing: 6px;
                    Text { text: "Battery"; font-weight: 600; color: #c8c8c8; }
                    HorizontalLayout { spacing: 10px; Text { text: "Auto Power Save"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[14].labels; current-index: root.global-choice-lists[14].selected; selected-index(index) => { root.set-global-choice(14, index); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "Auto LED Off"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[15].labels; current-index: root.global-choice-lists[15].selected; selected-index(index) => { root.set-global-choice(15, index); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Brightness"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactSpin { width: 92px; minimum: 1; maximum: 3; value: root.gb(root.goff(16)) + 1; edited => { root.set-global-byte(root.goff(16), self.value - 1); } } }
                    HorizontalLayout { spacing: 10px; Text { text: "LED Illumination"; width: 150px; horizontal-alignment: right; color: #f0f0f0; vertical-alignment: center; } CompactCombo { width: 130px; model: root.global-choice-lists[17].labels; current-index: root.global-choice-lists[17].selected; selected-index(index) => { root.set-global-choice(17, index); } } }
                    }
                    }
                    }
                    }
                }
            }
            }
                }
            }
        }

        Text {
            text: root.status;
            font-size: 12px;
            color: #555555;
        }
    }
}

export component AppWindow inherits Window {
    title: "KORG Kontrol Editor";
    preferred-width: 1100px;
    preferred-height: 760px;
    min-width: 1020px;
    min-height: 640px;

    in property <int> screen: 0;
    in property <[DeviceCard]> devices;
    in property <int> total-devices: 0;
    in-out property <int> device-view: 1;
    in-out property <string> search-text: "";
    in property <string> select-status: "";

    in property <bool> confirm-write-visible: false;
    in property <bool> confirm-global-write-visible: false;
    in property <int> tab: 0;
    in property <[BrowseFile]> browse-files;
    in-out property <string> browse-path: "";
    in property <bool> warn-before-write: true;
    in property <bool> auto-receive: false;
    in property <bool> can-calibrate: false;
    in property <bool> show-values: false;
    in property <string> port-name: "";
    in property <[string]> port-in-options;
    in property <int> port-in-index: -1;
    in property <[string]> port-out-options;
    in property <int> port-out-index: -1;
    in property <[string]> link-options;
    in property <int> link-index: -1;
    in property <int> global-length: 0;
    in property <[int]> global-bytes;
    in property <[int]> global-binding-offsets;
    in property <[GlobalChoiceList]> global-choice-lists;
    in property <string> global-channel: "1";
    in property <string> global-controller: "Native";
    in property <string> global-battery: "Alkaline";
    in property <string> global-name: "";
    in property <string> global-clock: "Auto";
    in property <string> global-bpm: "";
    in property <string> global-class: "";
    in property <int> global-tab: 0;
    in property <int> global-channel-value: 1;
    in property <int> global-clock-index: 0;
    in property <int> global-bpm-value: 1200;
    in property <int> global-battery-index: 0;
    in property <int> global-scrub-index: 0;
    in property <string> global-name-text: "";
    in property <int> global-mode-index: 0;
    in property <int> global-key-curve: 0;
    in property <int> global-pad-curve: 0;
    in property <int> global-touch-curve: 0;
    in property <bool> panel-visible: false;
    in property <[PanelControl]> panel-controls;
    in property <[ControlTreeRow]> control-tree;
    in property <bool> wireless-on;
    in property <string> wireless-how;
    in property <string> wireless-note;
    in property <int> device-scene: -1;
    in property <string> control-details;
    in property <float> panel-width: 550;
    in property <float> panel-height: 329;
    in property <image> panel-image;
    in property <bool> panel-has-image: false;
    in property <int> control-index: 0;
    in property <string> control-label: "";
    in property <string> device-name: "No device";
    in property <bool> dirty: false;
    in property <bool> offline: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;
    in property <bool> can-revert: false;
    in property <bool> monitor-visible: false;
    in property <[MonitorRow]> monitor-rows;
    in property <string> monitor-title: "";
    in property <[SceneTab]> scenes;
    in property <int> scene-index: 0;
    in property <[ParamRow]> params;
    in property <[ParamRow]> global-params;
    in property <[ParamBlock]> param-blocks;
    in property <string> status: "";
    in property <bool> transfer-enabled: false;
    in property <bool> transfer-busy: false;

    callback open-device(string);
    callback open-file();
    callback new-document();
    callback device-view-changed(int);
    callback search-changed(string);
    callback rescan();
    callback detect();
    callback show-devices();
    callback save-file();
    callback save-as();
    callback save-sysex();
    callback undo();
    callback revert();
    callback monitor-changed(bool);
    callback clear-monitor();
    callback redo();
    callback scene-selected(int);
    callback set-param(int, int, int);
    callback set-param-byte(int, int);
    callback set-param-text(int, string);
    callback set-global-param(int, int, int);
    callback set-global-param-label(int, int, string);
    callback set-param-choice(int, string);
    callback set-param-label(int, int, string);
    callback receive-data();
    callback write-data();
    callback cancel-transfer();
    callback confirm-write();
    callback cancel-write();
    callback control-selected(int);
    callback group-toggled(string);
    callback warn-changed(bool);
    callback auto-receive-changed(bool);
    callback calibrate();
    callback about();
    callback values-changed(bool);
    callback tab-selected(int);
    callback port-in-changed(string);
    callback port-out-changed(string);
    callback link-changed(string);
    in property <string> midi-backend-label: "MIDI";
    in property <string> midi-backend-note: "";
    in property <bool> midi-backend-enabled: false;
    callback midi-backend-switch();
    callback receive-global();
    callback global-tab-selected(int);
    callback set-global-byte(int, int);
    callback set-global-choice(int, int);
    callback set-global-text(int, string);
    callback set-global-bpm(int);
    callback write-global();
    callback confirm-global-write();
    callback cancel-global-write();
    callback open-factory(string);
    callback copy-scene();
    callback cut-scene();
    callback paste-scene();
    callback clear-scene();
    callback receive-scene-data();
    callback write-scene-data();

    if root.screen == 0 : DeviceSelect {
        devices: root.devices;
        total-devices: root.total-devices;
        device-view: root.device-view;
        search-text: root.search-text;
        status: root.select-status;
        open-device(class) => { root.open-device(class); }
        open-file() => { root.open-file(); }
        device-view-changed(value) => { root.device-view-changed(value); }
        search-changed(text) => { root.search-changed(text); }
        rescan() => { root.rescan(); }
        midi-backend-label: root.midi-backend-label;
        midi-backend-note: root.midi-backend-note;
        midi-backend-enabled: root.midi-backend-enabled;
        midi-backend-switch() => { root.midi-backend-switch(); }
        detect() => { root.detect(); }
    }

    if root.screen == 1 : Editor {
        device-name: root.device-name;
        dirty: root.dirty;
        offline: root.offline;
        can-undo: root.can-undo;
        can-redo: root.can-redo;
        can-revert: root.can-revert;
