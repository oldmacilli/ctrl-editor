// TEControl USB MIDI Breath Controller.
// Evidence: TECcontrol HANDOVER.md "Verified device protocol" (passive capture
// 2026-10-13, tec-device/hid-trace-2026-10-13*.log), tec-device/src/write.rs, and
// findings (TECcontrol fb97e8b: analysis and a
// read-only trace, hid-trace-2026-10-20-read-only.log).
cdl "0.1"

device "tecontrol.breath" {
    vendor "TEControl"
    model "USB MIDI Breath Controller"
    replaces "TECMidiBreathCtrl 2.app v5.3b1"
}

identify {
    // Usage page 0x0C alone also matches media-key interfaces; the USB ids
    // decide. TECcontrol writes only to this exact VID/PID/bcd (allow-list in
    // tec-device transport.rs); other firmware stays read-only.
    usb vid=0x2B06 pid=0x0018 bcd=0x0500 status="measured" evidence="ioreg 2026-10-20 (product 'Breath Controller 5.0-<serial>'); HANDOVER.md 'Device identity'; tec-device/src/transport.rs allow-list"
    hid usage-page=0x0C report-size=8 status="measured" evidence="firmware/descriptors-2026-10-14.txt"
    midi-port match="Breath" direction="out"
    key "usb-serial"                         // several controllers at once
}

// Configuration is HID only. The firmware emits MIDI by itself.
transport "hid" kind="hid" usage-page=0x0C frame=8 report-id=0 seize=#true status="measured"
transport "midi" kind="midi" port-match="Breath" role="performance"

types {
    enum "msg-type" status="measured" evidence="gate-5 capture" {
        value 0 "Control Change"
        value 1 "Aftertouch"
        value 2 "Pitch Bend Up"
        value 3 "Pitch Bend Down"
        value 4 "Pitch Bend Both"
    }
    // 0x10 means Disable; 0..15 shown as 1..16
    int "tec-channel" storage="u8" range="0..=16" display="{v + 1}" parse="{v - 1}" special="16=Disable"
    int "percent" storage="u8" range="0..=255" display="{v * 100 / 255}%"
}

block "sensor" count=4 names="Breath Bite Nod Tilt" status="measured" {
    group "meta" {
        field "cc" type="u7"
        field "channel" type="tec-channel"
        field "message" type="msg-type"
        // Device-provided: byte 3 of the meta reply, copied and echoed back on
        // upload by the original. 09 on every unit seen; meaning unknown.
        field "param" type="u8" status="decoded" evidence="TECcontrol findings"
        field "attack" type="u8"
        field "decay" type="u8"
    }
    group "shaping" {
        field "bending" type="percent"
        field "symmetry" type="percent"
        field "sensor-min" type="percent"
        field "sensor-max" type="percent"
        field "midi-min" type="percent"
        field "midi-max" type="percent"
    }
    // 32 values, computed from shaping by the original's generator; the
    // device cannot report them back
    array "curve" count=32 type="u7" driver="tec-curve"
}

// 4 sensor values (7-bit) and 4 changed flags (0 or 1).
message "poll" transport="hid" status="measured" evidence="1947 + 89 polls, 352/352 flags matched; vendor analysis" {
    send "00"
    reply "{breath} {bite} {nod} {tilt} {breath-changed} {bite-changed} {nod-changed} {tilt-changed}" timeout=200
}
// Bytes 6 and 7 of the read replies are 00 (65 meta and 8 shaping replies).
message "read-meta" transport="hid" status="measured" evidence="TECcontrol findings" {
    send "{0x10 + s}"
    reply "{cc} {channel} {message} {param} {attack} {decay} 00 00" timeout=200
    // TECcontrol rejects any other byte 3 (protocol.rs Metadata::parse)
    ok-when "param == 9"
}
message "write-meta" transport="hid" kind="write" status="measured" {
    send "{0x20 + s} {cc} {channel} {message} {param} {attack} {decay} 00"
    reply "00 00 00 00 00 00 00 00" timeout=200
}
message "read-shaping" transport="hid" status="measured" evidence="TECcontrol findings" {
    send "{0x14 + s}"
    reply "{bending} {symmetry} {sensor-min} {sensor-max} {midi-min} {midi-max} 00 00" timeout=200
}
message "write-shaping" transport="hid" kind="write" status="measured" {
    send "{0x24 + s} {bending} {symmetry} {sensor-min} {sensor-max} {midi-min} {midi-max} 00"
    reply "00 00 00 00 00 00 00 00" timeout=200
}
// 32 values go out as 6 pages of 6: byte 1 is the start index (0, 6, … 30),
// and the last page pads indexes 32..35 with 7F.
message "write-curve-page" transport="hid" kind="write" status="measured" evidence="tec-device write.rs curve_frames; vendor analysis" {
    send "{0x40 + s} {start} {curve[6] pad=7F}"
    reply "00 00 00 00 00 00 00 00" timeout=200
}
message "commit" transport="hid" kind="commit" status="measured" evidence="gate-5, gate-6: ack after 621 ms" {
    send "50"
    reply "00 00 00 00 00 00 00 00" timeout=2000
}
// Never sent by this editor yet. The original sends it only for a sensor
// whose present bit is set, reads one reply and ignores it, then waits 3 s;
// no verify and no commit follow.
message "calibrate" transport="hid" kind="commit" status="decoded" evidence="vendor analysis" {
    send "{0x60 + s}"
    reply ".. .. .. .. .. .. .. .." timeout=3000
}
// Sent by the original after the baseline reads. Its reply byte only drives
// a UI boolean (00 and 01 seen; 00 live); nothing may gate on it.
message "status-51" transport="hid" status="measured" evidence="vendor analysis; captures 2026-10-13 and 2026-10-20" {
    send "51"
}

procedure "read-all" kind="read" transport="hid" {
    repeat "s" "0..=3" {
        exchange "read-meta" s="{s}" into="sensor[s].meta"
        exchange "read-shaping" s="{s}" into="sensor[s].shaping"
    }
}

// The original sends meta, shaping and the 6 curve pages per sensor.
procedure "write-sensor" kind="write" transport="hid" {
    gate "confirm" text="Write sensor {s} to the controller's RAM?"
    restore-point "sensor[s]"
    exchange "write-meta" from="sensor[s].meta"
    exchange "write-shaping" from="sensor[s].shaping"
    // the curve cannot be read back, so verify compares meta and shaping only
    repeat "p" "0..=5" {
        exchange "write-curve-page" start="{p * 6}" from="sensor[s].curve[p * 6 .. p * 6 + 6]"
    }
    verify "read-all" compare="sensor[s].meta sensor[s].shaping"
}

procedure "make-permanent" kind="commit" transport="hid" {
    gate "arm" text="Store the current RAM settings in the controller's flash?"
    exchange "commit"
}

midi-map transport="midi" {
    source "sensor" count=4 kind="from-field" message="{sensor.$i.message}" cc="{sensor.$i.cc}" channel="{sensor.$i.channel}"
}

panel source="drawn from the original's window" status="inferred" {
    control "breath" kind="meter" bind="sensor[0]" live="poll.breath"
    control "bite" kind="meter" bind="sensor[1]" live="poll.bite"
    control "nod" kind="meter" bind="sensor[2]" live="poll.nod"
    control "tilt" kind="meter" bind="sensor[3]" live="poll.tilt"
}

// Computes the 32 curve values from the shaping settings, byte-exact with
// the original's generator and quantizer.
driver "tec-curve" provides="block:sensor.curve" from="sensor.shaping" status="decoded" evidence="TECcontrol findings"

firmware status="unknown" evidence="firmware/README.md; TECcontrol findings: no update strings, no opcode above 0x60, no handler in the vendor app" {
    recovery "No update path exists."
}

test-vector "commit" message="commit" status="measured" evidence="hid-trace gate-5" {
    bytes "50 00 00 00 00 00 00 00"
}
