cdl "0.1"
// The overview retains access to fields without a dedicated panel control.
editor-pages default="Overview" status="decoded" evidence="KORG parameter analysis and editor labels" {
    select "Overview" group="Octave"
    select "Overview" group="Wheel" label="Pitch"
    select "Mod Wheel" group="Wheel" label="Mod"
    select "Keyboard" group="Keyboard"
    page "Overview" {
        field "Common" offset=0 kind="heading"
        field "MIDI Channel" offset=0 kind="channel-only"
        field "Keyboard" offset=0 kind="heading"
        field "Transpose" offset=8 kind="biased" min=-12 max=12 bias=64
        field "Velocity Curve" offset=9 kind="number" min=0 max=3
        field "Const Velocity Value" offset=10 kind="number" min=0 max=127
        field "Mod Wheel" offset=0 kind="heading"
        field "Wheel Enable" offset=16 kind="choice" { choice "Disable"; choice "Enable"; }
        field "CC Number" offset=17 kind="number" min=0 max=127
        field "Bottom Value" offset=19 kind="number" min=0 max=127
        field "Top Value" offset=20 kind="number" min=0 max=127
        field "Assignable Switch" offset=0 kind="heading"
        field "CC Number" offset=41 kind="number" min=0 max=127
        field "Pedal Polarity" offset=45 kind="choice" { choice "Auto"; choice "Minus"; choice "Plus"; }
        field "Wireless" offset=0 kind="heading"
        field "Device Name" offset=208 kind="text" width=26
        field "Encryption" offset=234 kind="choice" { choice "Off"; choice "On"; }
        field "Auto Power Off" offset=240 kind="choice" { choice "Disable"; choice "Enable"; }
        field "Battery Type" offset=241 kind="choice" { choice "Alkaline"; choice "Ni-MH"; }
    }
    page "Keyboard" {
        field "Transpose" offset=8 kind="biased" min=-12 max=12 bias=64
        field "Velocity Curve" offset=9 kind="number" min=0 max=3
        field "Const Velocity Value" offset=10 kind="number" min=0 max=127
    }
    page "Mod Wheel" {
        field "Wheel Enable" offset=16 kind="choice" { choice "Disable"; choice "Enable"; }
        field "CC Number" offset=17 kind="number" min=0 max=127
        field "Bottom Value" offset=19 kind="number" min=0 max=127
        field "Top Value" offset=20 kind="number" min=0 max=127
    }
}
