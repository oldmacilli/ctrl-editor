cdl "0.1"
// The vendor editor opens no page for the pitch wheel and the octave keys.
// The overview stays the default page for fields without a panel control.
editor-pages default="Overview" status="decoded" evidence="KORG parameter analysis and editor labels" {
    select "Mod Wheel" group="Wheel" label="Mod"
    select "Keyboard" group="Keyboard"
    select "Assignable Switch" group="Assignable Switch"
    select "Common" group="Common"
    select "Wireless" group="Wireless"
    fixed "Fixed on this device: always sends Pitch Bend; nothing to set." label="Pitch"
    fixed "Fixed on this device: shifts the keyboard by an octave; nothing to set." group="Octave"
    page "Overview" {
        field "Common" offset=0 kind="heading"
        field "MIDI Channel" offset=0 kind="channel-only"
        field "Keyboard" offset=0 kind="heading"
        field "Transpose" offset=8 kind="biased" min=-12 max=12 bias=64
        field "Velocity Curve" offset=9 kind="choice" { choice "Velocity Curve 1"; choice "Velocity Curve 2"; choice "Velocity Curve 3"; choice "Velocity Curve 4"; choice "Velocity Curve 5"; choice "Velocity Curve 6"; choice "Velocity Curve 7"; choice "Velocity Curve 8"; choice "Const"; }
        field "Const Velocity Value" offset=10 kind="number" min=1 max=127 enabled-if-offset=9 enabled-if-value=8
        field "Mod Wheel" offset=0 kind="heading"
        field "Wheel Enable" offset=16 kind="choice" { choice "Disable"; choice "Enable"; }
        field "CC Number" offset=17 kind="number" min=0 max=127
        field "Bottom Value" offset=19 kind="number" min=0 max=127
        field "Top Value" offset=20 kind="number" min=0 max=127
        field "Assignable Switch" offset=0 kind="heading"
        field "CC Number" offset=41 kind="number" min=0 max=127
        field "Pedal Polarity" offset=45 kind="choice" { choice "Auto"; choice "Minus"; choice "Plus"; }
        field "Wireless" offset=0 kind="heading"
        field "Device Name" offset=208 kind="text" width=26 write-width=16 padding=0
        field "Connection Type" offset=234 kind="choice" { choice "2"; choice "1"; }
        field "Auto Power Off" offset=240 kind="choice" { choice "Disable"; choice "Enable"; }
        field "Battery Type" offset=241 kind="choice" { choice "Alkaline"; choice "Ni-MH"; }
    }
    page "Keyboard" {
        field "Transpose" offset=8 kind="biased" min=-12 max=12 bias=64
        field "Velocity Curve" offset=9 kind="choice" { choice "Velocity Curve 1"; choice "Velocity Curve 2"; choice "Velocity Curve 3"; choice "Velocity Curve 4"; choice "Velocity Curve 5"; choice "Velocity Curve 6"; choice "Velocity Curve 7"; choice "Velocity Curve 8"; choice "Const"; }
        field "Const Velocity Value" offset=10 kind="number" min=1 max=127 enabled-if-offset=9 enabled-if-value=8
    }
    page "Common" {
        field "MIDI Channel" offset=0 kind="channel-only"
    }
    page "Mod Wheel" {
        field "Wheel Enable" offset=16 kind="choice" { choice "Disable"; choice "Enable"; }
        field "CC Number" offset=17 kind="number" min=0 max=127
        field "Bottom Value" offset=19 kind="number" min=0 max=127
        field "Top Value" offset=20 kind="number" min=0 max=127
    }
    page "Assignable Switch" {
        field "CC Number" offset=41 kind="number" min=0 max=127
        field "Pedal Polarity" offset=45 kind="choice" { choice "Auto"; choice "Minus"; choice "Plus"; }
    }
    page "Wireless" {
        field "Device Name" offset=208 kind="text" width=26 write-width=16 padding=0
        field "Connection Type" offset=234 kind="choice" { choice "2"; choice "1"; }
        field "Auto Power Off" offset=240 kind="choice" { choice "Disable"; choice "Enable"; }
        field "Battery Type" offset=241 kind="choice" { choice "Alkaline"; choice "Ni-MH"; }
    }
}

// The vendor editor's group list, in its order.  Groups without a panel
// control are reached through this list.
labels "en" {
    list "editor-page-navigation" {
        item 0 "Common"
        item 1 "Keyboard"
        item 2 "Mod Wheel"
        item 3 "Assignable Switch"
        item 4 "Wireless"
    }
}
