cdl "0.1"

device "korg.nanokey-fold" {
    vendor "KORG"
    model "nanoKEY Fold"
    class "X20880"
    file-key "2088"
    image "assets/nanokey-fold/thumbnail.png" role="thumbnail"
    image "assets/nanokey-fold/list-icon.png" role="list-icon"
}

const "model" 0x16a status="decoded" evidence="KORG analysis/sysex/descriptors.json: X20880SysExGenerator descriptor, length style short_or_long"

// The port name is not recorded; the user picks it, or a scan finds the
// device by its identity reply (CDL 5.1). Long SysEx goes to the host in
// 256-byte pieces, 5 ms apart (CDL 8.2; KORG korg-midi-midir SYSEX_CHUNK).
transport "midi" kind="midi" role="config" scan="identity" sysex-limit=256 segment-delay=5 status="decoded" evidence="X20880SysExGenerator in the vendor application" {
    capture "device-id" from="identity"
}

block "scene" size=304 count=15 status="decoded" evidence="KORG analysis/products/catalog.json (factory data)"
