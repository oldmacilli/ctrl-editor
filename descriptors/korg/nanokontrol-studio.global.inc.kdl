cdl "0.1"
global-fields name-label="Wireless Device Name" name-offset=8 name-width=26 status="decoded" evidence="KORG global data analysis" {
    binding "channel" label="Global MIDI Channel" offset=0 min=1 max=16 bias=-1 status="decoded" evidence="existing editor range"
    binding "battery" label="Battery Type" offset=2 status="decoded" evidence="KORG global data analysis" {
        choice "Alkaline" value=0 status="inferred" evidence="existing UI choice order"
        choice "Ni-MH" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "controller-mode" label="Controller Mode" offset=1 status="decoded" evidence="KORG global data analysis" {
        choice "Assignable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Cubase" value=1 status="inferred" evidence="existing UI choice order"
        choice "Digital Performer" value=2 status="inferred" evidence="existing UI choice order"
        choice "Live" value=3 status="inferred" evidence="existing UI choice order"
        choice "Pro Tools" value=4 status="inferred" evidence="existing UI choice order"
        choice "SONAR" value=5 status="inferred" evidence="existing UI choice order"
        choice "Studio One" value=6 status="inferred" evidence="existing UI choice order"
    }
    binding "scrub" label="Use Scene Button as Scrub" offset=3 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="original editor UI choice order"
        choice "Enable" value=1 status="inferred" evidence="original editor UI choice order"
    }
    binding "usb-led-off" label="Auto LED Off" offset=65 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "usb-brightness" label="LED Brightness" offset=66 min=1 max=3 bias=-1 status="decoded" evidence="existing editor range"
    binding "usb-illumination" label="LED Illumination" offset=67 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-power" label="Auto Power Save" offset=72 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "30 min" value=1 status="inferred" evidence="existing UI choice order"
        choice "1 hour" value=2 status="inferred" evidence="existing UI choice order"
        choice "2 hours" value=3 status="inferred" evidence="existing UI choice order"
        choice "4 hours" value=4 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-led-off" label="Auto LED Off" offset=73 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-brightness" label="LED Brightness" offset=74 min=1 max=3 bias=-1 status="decoded" evidence="existing editor range"
    binding "battery-illumination" label="LED Illumination" offset=75 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
}
