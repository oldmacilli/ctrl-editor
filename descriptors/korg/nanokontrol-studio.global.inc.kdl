cdl "0.1"
global-fields name-offset=8 name-width=26 status="decoded" evidence="KORG global data analysis" {
    binding "channel" offset=0 status="decoded" evidence="KORG global data analysis"
    binding "battery" offset=2 status="decoded" evidence="KORG global data analysis" {
        choice "Alkaline" value=0 status="inferred" evidence="existing UI choice order"
        choice "Ni-MH" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "controller-mode" offset=1 status="decoded" evidence="KORG global data analysis" {
        choice "Assignable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Cubase" value=1 status="inferred" evidence="existing UI choice order"
        choice "Digital Performer" value=2 status="inferred" evidence="existing UI choice order"
        choice "Live" value=3 status="inferred" evidence="existing UI choice order"
        choice "Pro Tools" value=4 status="inferred" evidence="existing UI choice order"
        choice "SONAR" value=5 status="inferred" evidence="existing UI choice order"
        choice "Studio One" value=6 status="inferred" evidence="existing UI choice order"
    }
    binding "scrub" offset=3 status="decoded" evidence="KORG global data analysis" {
        choice "Off" value=0 status="inferred" evidence="existing UI choice order"
        choice "On" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "usb-led-off" offset=65 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "usb-brightness" offset=66 status="decoded" evidence="KORG global data analysis"
    binding "usb-illumination" offset=67 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-power" offset=72 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "30 min" value=1 status="inferred" evidence="existing UI choice order"
        choice "1 hour" value=2 status="inferred" evidence="existing UI choice order"
        choice "2 hours" value=3 status="inferred" evidence="existing UI choice order"
        choice "4 hours" value=4 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-led-off" offset=73 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-brightness" offset=74 status="decoded" evidence="KORG global data analysis"
    binding "battery-illumination" offset=75 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
}
