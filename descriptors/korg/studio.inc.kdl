// Measured on the nanoKEY Studio (X14800) and nanoKONTROL Studio (X14802):
// included by both after common.inc.kdl. Evidence: KORG_Kontrol_Editor
// korg-sysex capture tests, korg-core MeasuredSession, hardware runs
// (KORG eba516b, aaa4f36, fbf74bc).
cdl "0.1"

// The common frame and identity, measured on these two models.
sysex-frame "korg-native" status="measured" evidence="byte-identical with the captured requests, writes and acks (korg-sysex tests measured_requests_match_the_capture, measured_write_frames_match_the_capture)"
message "identity" status="measured" evidence="replies captured from both Studios over USB and Bluetooth (korg-sysex identity_replies_parse_for_both_studios)"

// Every Studio body starts with a 3-byte 7-bit length, low byte first,
// that counts the bytes after it (common.inc.kdl). The analysed parser
// reads it at bytes 6..8 and the first body byte at 9. An
// ack is a one-byte body, the status: captured as 01 00 00 23 (23 in 31
// frames from X14800 and 8 from X14802) and 01 00 00 21 (the X14802 scene
// write) (docs/midi-sysex.md).
pattern "korg-ack" "{len:u21le} {status}"
// Data bodies: marker 40 for a scene, 51 for the global block, then the
// block 7-in-8 packed. The length tells the scene sizes apart: 01 05 00
// (641, a 560-byte nanoKONTROL Studio scene), 14 02 00 (276, a 240-byte
// nanoKEY Studio scene), 14 01 00 (148, the 128-byte global block).
pattern "scene-data" "{len:u21le} 40 {data:packed7}"
pattern "global-data" "{len:u21le} 51 {data:packed7}"
const "data-received" 0x23
const "write-complete" 0x21

// The measured requests (korg-sysex Request, docs/midi-sysex.md).
message "scene-set-info-request" frame="korg-native" transport="selected" status="measured" evidence="korg-sysex Request::SceneSetInfo; capture: 02 00 00 42 00 on X14800 and X14802" {
    send "{len:u21le} 12"
    // Five-byte readiness reply; no block. The final byte is zero in every
    // capture and its meaning is unknown.
    reply "{len:u21le} 42 {info}" variant="info" timeout=1000
}
message "select-scene" frame="korg-native" transport="selected" status="measured" evidence="korg-sysex Request::SelectScene; capture" {
    // 0..count-1 of this device's scene block (5 or 8 scenes)
    arg "scene" index="scene"
    send "{len:u21le} 14 {scene}"
    reply pattern="korg-ack" variant="ack" timeout=2000
    ok-when "status == data-received"
}
message "read-block-request" frame="korg-native" transport="selected" status="measured" evidence="korg-sysex Request::ReadBlock; capture" {
    send "{len:u21le} 10"
    reply pattern="scene-data" variant="scene" timeout=2000
}
message "global-data-request" frame="korg-native" transport="selected" status="measured" evidence="korg-sysex Request::GlobalData; capture" {
    send "{len:u21le} 0E"
    reply pattern="global-data" variant="global" timeout=2000
}
message "commit-scene" frame="korg-native" transport="selected" kind="write" status="measured" evidence="korg-sysex build_commit, korg-core MeasuredSession::write_scene; ack 21 captured" {
    // 0..count-1 of this device's scene block (5 or 8 scenes)
    arg "scene" index="scene"
    send "{len:u21le} 11 {scene}"
    reply pattern="korg-ack" variant="ack" timeout=2000
    ok-when "status == write-complete"
}
message "global-write" frame="korg-native" transport="selected" kind="write" status="measured" evidence="korg-devices global_write_header for 0x136 and 0x137; byte-identical write and re-receive on X14802 (KORG eba516b) and X14800 (KORG aaa4f36)" {
    send pattern="global-data"
    // 23 = data received; the global write has no commit
    reply pattern="korg-ack" variant="ack" timeout=2000
    ok-when "status == data-received"
}

// The scene write; the block's size sets the length.
message "scene-write" frame="korg-native" transport="selected" kind="write" status="measured" evidence="korg-sysex X14802_SCENE_WRITE_HEADER, build_write_frame; capture (X14802); korg-devices measured_layout(0x136), scene-set write verified unchanged (KORG aaa4f36, X14800)" {
    send pattern="scene-data"
    reply pattern="korg-ack" variant="ack" timeout=2000
    ok-when "status == data-received"
}

procedure "receive-global" kind="read" status="measured" {
    exchange "scene-set-info-request"
    exchange "global-data-request" into="global"
}
procedure "write-global" kind="write" status="measured" evidence="KORG eba516b (X14802), aaa4f36 (X14800)" {
    gate "confirm" text="Write the global settings to the device?"
    restore-point "global"
    exchange "global-write" from="global"
    verify "receive-global" compare="global"
}

