cdl "0.1"

device "korg.taktile-25-49" {
    vendor "KORG"
    model "taktile-25/49"
    class "X11850"
    file-key "1850"
    image "assets/taktile-25-49/thumbnail.png" role="thumbnail"
    image "assets/taktile-25-49/list-icon.png" role="list-icon"
}

const "model" 0x11c status="decoded" evidence="KORG analysis/sysex/descriptors.json: X11850SysExGenerator descriptor, length style short_or_long"

// The port name is not recorded; the user picks it, or a scan finds the
// device by its identity reply (CDL 5.1). SysEx longer than 4096 bytes
// goes to the host in pieces (CDL 8.2: Linux ALSA rawmidi buffers).
transport "midi" kind="midi" role="config" scan="identity" sysex-limit=4096 status="decoded" evidence="X11850SysExGenerator in the vendor application" {
    capture "device-id" from="identity"
}

block "scene" size=640 count=16 status="decoded" evidence="KORG analysis/products/catalog.json (factory data)"
block "global" size=88 status="decoded" evidence="KORG analysis/products/catalog.json (factory data)"

driver "korg-file" provides="file:taktile_data file:taktile_glob file:taktile_set" status="decoded" evidence="KORG analysis/products/catalog.json (Info.plist document types)"

