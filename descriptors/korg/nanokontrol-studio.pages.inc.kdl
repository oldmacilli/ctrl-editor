    page "Scene" {
        field "Scene Name" offset=0 kind="text" width=12
        field "LED Mode" offset=12 kind="choice" status="inferred" evidence="Editor choice order" {
            choice "Internal"
            choice "External"
        }
    }
    page "Jog Wheel" {
        field "Type" offset=513 kind="choice" status="inferred" evidence="Editor choice order and device observations" {
            choice "Inc/Dec 1"
            choice "Inc/Dec 2"
            choice "Continuous"
            choice "Sign Magnitude"
            choice "No Assign"
            choice "Encoder 01/7F"
            choice "Encoder 3F/41"
        }
        field "Acceleration" offset=514 kind="choice" hidden-if-offset=513 {
            choice "1"
            choice "2"
            choice "Const"
            hide-if-value 4
        }
        field "MIDI Channel" offset=512 kind="channel"
        field "CC Number" offset=515 kind="number" min=0 max=127 hidden-if-offset=513 {
            hide-if-value 0
            hide-if-value 1
            hide-if-value 2
            hide-if-value 4
        }
