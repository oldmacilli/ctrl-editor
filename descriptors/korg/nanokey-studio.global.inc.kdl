cdl "0.1"
global-fields name-label="Wireless Device Name" name-offset=8 name-width=26 bpm-label="BPM" bpm-offset=57 bpm-min=200 bpm-max=3000 chord-pad-label="Chord Pad" easy-scale-label="Easy Scale" status="decoded" evidence="KORG global data analysis; BPM word at 57-58: vendor table writes id 44 at both bytes, factory and device (fw 1.08, 2026-11-13) hold B0 04 = 120.0" {
    binding "channel" label="Global MIDI Channel" offset=0 min=1 max=16 bias=-1 status="decoded" evidence="existing editor range"
    binding "battery" label="Battery Type" offset=1 status="decoded" evidence="KORG global data analysis" {
        choice "Alkaline" value=0 status="inferred" evidence="existing UI choice order"
        choice "Ni-MH" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "clock" label="MIDI Clock Source" offset=56 status="decoded" evidence="KORG global data analysis" {
        choice "Auto" value=0 status="inferred" evidence="existing UI choice order"
        choice "Internal" value=1 status="inferred" evidence="existing UI choice order"
        choice "External-USB" value=2 status="inferred" evidence="existing UI choice order"
    }
    binding "key-curve" label="Velocity Curve" offset=48 status="decoded" evidence="KORG global data analysis" {
        choice "Light" value=0 status="inferred" evidence="existing UI choice order"
        choice "Mid-Light" value=1 status="inferred" evidence="existing UI choice order"
        choice "Normal" value=2 status="inferred" evidence="existing UI choice order"
        choice "Mid-Heavy" value=3 status="inferred" evidence="existing UI choice order"
        choice "Heavy" value=4 status="inferred" evidence="existing UI choice order"
        choice "Const" value=5 status="inferred" evidence="existing UI choice order"
    }
    binding "key-constant" label="Velocity Const Value" offset=49 min=1 max=127 status="decoded" evidence="existing editor range"
    binding "pad-curve" label="Velocity Curve" offset=50 status="decoded" evidence="KORG global data analysis" {
        choice "Light" value=0 status="inferred" evidence="existing UI choice order"
        choice "Mid-Light" value=1 status="inferred" evidence="existing UI choice order"
        choice "Normal" value=2 status="inferred" evidence="existing UI choice order"
        choice "Mid-Heavy" value=3 status="inferred" evidence="existing UI choice order"
        choice "Heavy" value=4 status="inferred" evidence="existing UI choice order"
        choice "Const" value=5 status="inferred" evidence="existing UI choice order"
    }
    binding "pad-constant" label="Velocity Const Value" offset=51 min=1 max=127 status="decoded" evidence="existing editor range"
    binding "pad-sensitivity" label="Sensitivity" offset=52 min=1 max=3 bias=-1 status="decoded" evidence="existing editor range"
    binding "touch-velocity" label="Note On Velocity" offset=53 min=0 max=127 status="decoded" evidence="existing editor range"
    binding "touch-curve" label="Return Speed" offset=54 status="decoded" evidence="KORG global data analysis" {
        choice "Immediate" value=0 status="inferred" evidence="existing UI choice order"
        choice "Fast" value=1 status="inferred" evidence="existing UI choice order"
        choice "Normal" value=2 status="inferred" evidence="existing UI choice order"
        choice "Slow" value=3 status="decoded" evidence="vendor return-speed combo (fourth item); vendor range 0..3"
    }
    binding "chord-octave" label="Chord Pad Octave Offset" offset=40 min=-2 max=2 bias=64 status="decoded" evidence="vendor global table id 47, range -2..2, bias 64; label from the vendor global screen (order inferred)"
    binding "scale-octave" label="Easy Scale Octave Offset" offset=41 min=-2 max=2 bias=64 status="decoded" evidence="vendor global table id 48, range -2..2, bias 64; label from the vendor global screen (order inferred)"
    binding "usb-power" label="Auto Power Off (USB)" offset=72 status="decoded" evidence="vendor global table id 34 (AutoPowerOffType); the vendor screen does not show it" {
        choice "Disable" value=0 status="inferred" evidence="same type as battery-power"
        choice "30 min" value=1 status="inferred" evidence="same type as battery-power"
        choice "1 hour" value=2 status="inferred" evidence="same type as battery-power"
        choice "2 hours" value=3 status="inferred" evidence="same type as battery-power"
        choice "4 hours" value=4 status="inferred" evidence="same type as battery-power"
    }
    binding "usb-led-off" label="Auto LED Off" offset=73 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "usb-brightness" label="LED Brightness" offset=74 min=1 max=3 bias=-1 status="decoded" evidence="existing editor range"
    binding "usb-illumination" label="LED Illumination" offset=75 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "usb-eco" label="LED Eco Mode" offset=76 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-power" label="Auto Power Off" offset=80 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "30 min" value=1 status="inferred" evidence="existing UI choice order"
        choice "1 hour" value=2 status="inferred" evidence="existing UI choice order"
        choice "2 hours" value=3 status="inferred" evidence="existing UI choice order"
        choice "4 hours" value=4 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-led-off" label="Auto LED Off" offset=81 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-brightness" label="LED Brightness" offset=82 min=1 max=3 bias=-1 status="decoded" evidence="existing editor range"
    binding "battery-illumination" label="LED Illumination" offset=83 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
    binding "battery-eco" label="LED Eco Mode" offset=84 status="decoded" evidence="KORG global data analysis" {
        choice "Disable" value=0 status="inferred" evidence="existing UI choice order"
        choice "Enable" value=1 status="inferred" evidence="existing UI choice order"
    }
}
