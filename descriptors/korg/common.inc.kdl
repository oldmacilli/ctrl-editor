// Shared by every KORG device descriptor (include "common.inc.kdl"): what
// korg-sysex builds for every model. Decoded here; studio.inc.kdl raises it
// to measured for the two Studios. Each device declares `const "model"`.
// Evidence: KORG_Kontrol_Editor crates/korg-sysex.
cdl "0.1"

const "manufacturer" 0x42 status="measured" evidence="korg-sysex KORG_ID; byte 5 of the identity replies captured 2026-10-20"

// KORG native SysEx, built from generic parts (CDL §8.1):
//   F0, the manufacturer as a MIDI ID (42), 0x40 | device id, the model as
//   a MIDI ID (0x137 is 00 01 37), then the command bytes, then F7.
// The device id is the stored setting from the identity reply (nanoKONTROL
// Studio 00, nanoKEY Studio 0F, over USB and Bluetooth alike); it is not a
// MIDI channel. Replies use the same frame, so `{0x40 | device-id}` checks
// the id when it is known and captures it when it is not.
sysex-frame "korg-native" status="decoded" evidence="korg-sysex build_request, build_write_frame, build_commit, build_data_message (push_model)" {
    prefix "F0 {manufacturer:midi-id} {0x40 | device-id} {model:midi-id}"
    suffix "F7"
}

// The universal identity request. The reply carries the device id and the
// model as two bytes, low first (0x137 is 37 01); a reply from another
// model does not match, because `model` is a constant.
message "identity" transport="selected" status="decoded" evidence="korg-sysex IDENTITY_REQUEST, parse_identity" {
    send "F0 7E 7F 06 01 F7"
    reply "F0 7E {device-id} 06 02 {manufacturer:midi-id} {model:u16le} {member:u16le} {version:u16le} .. .. F7" timeout=1000
}

types {
    int "channel" storage="u7" range="0..=15" display="{v + 1}" parse="{v - 1}"
    // korg-sysex AckStatus
    errors "ack" status="decoded" evidence="korg-sysex AckStatus" {
        value 0x21 "Write complete"
        value 0x22 "Write error"
        value 0x23 "Data received"
        value 0x24 "Not acknowledged"
    }
}

// Studio facts (requests, writes, the measured exchanges): studio.inc.kdl.
