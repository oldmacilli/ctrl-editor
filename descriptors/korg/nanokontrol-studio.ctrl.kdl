// KORG nanoKONTROL Studio (class X14802, file key 1482, SysEx model 0x137).
// Evidence: KORG_Kontrol_Editor crates/korg-devices (measured_layout 0x137),
// crates/korg-sysex, crates/korg-model (JogConfig), hardware receive 2026-10-20.
// The SysEx exchanges, acknowledgements and block replies are CDL messages.
// The scene layout is decoded for the name and the jog block.
cdl "0.1"
include "common.inc.kdl"
include "studio.inc.kdl"
include "nanokontrol-studio.gen.inc.kdl"

device "korg.nanokontrol-studio" {
    vendor "KORG"
    model "nanoKONTROL Studio"
    class "X14802"
    file-key "1482"
}

identify {
    midi-port match="nanoKONTROL Studio" direction="both"
    sysex-identity manufacturer=0x42 model=0x137 status="measured"
}

// Two config transports: USB is preferred; the user's port choice (p in
// the TUI, the port preference in the GUI) overrides it.
transport "usb" kind="midi" port-match="nanoKONTROL Studio CTRL" role="config" preferred=#true sysex-limit=4096 {
    capture "device-id" from="identity"
}
transport "ble" kind="midi" sysex-limit=4096 port-match="nanoKONTROL Studio Bluetooth" role="config" status="measured" evidence="TUI receive over Bluetooth, 2026-10-20" {
    capture "device-id" from="identity"
}

types {
    // The generated `jog-dial-value-type` is the four-label list from
    // KORG UI strings in UI order (No Assign, Sign Magnitude, Inc/Dec,
    // Continuous), not the wire codes. Measured codes 0..6 differ: two
    // Inc/Dec forms and two encoder forms. Keep this measured enum.
    enum "jog-type" {
        value 0 "Inc/Dec 1" status="inferred"
        value 1 "Inc/Dec 2" status="measured"
        value 2 "Continuous" status="measured"
        value 3 "Sign Magnitude" status="measured"
        value 4 "No Assign" status="inferred"
        value 5 "Encoder 01/7F" status="measured"
        value 6 "Encoder 3F/41" status="inferred"
    }
    enum "jog-accel" {
        value 0 "1"
        value 1 "2"
        value 2 "Const"
    }
}

// Frame, identity, requests, global read/write: common.inc.kdl.
const "model" 0x137 status="measured" evidence="identity reply 37 01, captured 2026-10-20; korg-devices measured_layout(0x137)"

block "scene" size=560 count=5 status="measured" evidence="measured_layout(0x137)" {
    field "name" offset=0 type="ascii(16)"
    group "jog" offset=512 evidence="korg-model JogConfig::decode" {
        field "channel" offset=0 type="channel"
        field "type" offset=1 type="jog-type"
        field "acceleration" offset=2 type="jog-accel"
        field "sign-cc" offset=3 type="u7" visible-when="type == 3 || type >= 5"
        field "cw-cc" offset=4 type="u7" visible-when="type <= 1"
        field "ccw-cc" offset=5 type="u7" visible-when="type <= 1"
        field "cc" offset=6 type="u7" visible-when="type == 2"
        field "min" offset=7 type="u7" visible-when="type == 2"
        field "max" offset=8 type="u7" visible-when="type == 2"
    }
    array "knob" count=8 status="unknown"
    array "slider" count=8 status="unknown"
}
block "global" size=128 status="measured" evidence="measured_layout(0x137)"

procedure "receive-scene-set" kind="read" status="measured" {
    exchange "scene-set-info-request"
    repeat "s" "0..=4" {
        exchange "select-scene" scene="{s}"
        exchange "read-block-request" into="scene[s]"
    }
}
procedure "write-scene" kind="write" status="measured" {
    gate "confirm" text="Write scene {scene} to the device?"
    restore-point "scene[scene]"
    exchange "scene-write" from="scene[scene]"
    exchange "commit-scene" scene="{scene}"
    verify "receive-scene-set" compare="scene[scene]"
}
procedure "write-scene-set" kind="write" status="measured" {
    gate "confirm" text="Write all 5 scenes to the device?"
    restore-point "scene"
    repeat "s" "0..=4" {
        exchange "scene-write" from="scene[s]"
        exchange "commit-scene" scene="{s}"
    }
    verify "receive-scene-set" compare="scene"
}

// Panel: korg_app::panel nanokontrol_studio(), picture 550 x 329.
panel picture="550x329" source="measured by eye from the editor's panel picture" {
    control "jog" kind="jog" label="Jog Wheel" group="Jog Wheel" box="36,199,92,92" bind="scene.jog"
    control "scene" kind="button" label="Scene" group="Scene" box="25,93,22,12"
    repeat "n" "1..=8" {
        control "knob{n}" kind="knob" label="Knob {n}" group="Knob" box="{135.5 + 44.5 * n},146,28,28"
        control "slider{n}" kind="fader" label="Slider {n}" group="Slider" box="{128.5 + 44.5 * n},188,14,116"
    }
}

// Byte for byte from korg-sysex's tests (captured from the hardware unless
// noted), device id 00.
test-vector "identity-request" message="identity" status="measured" evidence="korg-sysex IDENTITY_REQUEST" {
    bytes "F0 7E 7F 06 01 F7"
}
test-vector "identity-reply" message="identity" reply=#true status="measured" evidence="korg-sysex identity_replies_parse_for_both_studios" {
    args device-id=0 member=0 version=5
    bytes "F0 7E 00 06 02 42 37 01 00 00 05 00 01 00 F7"
}
test-vector "global-data-request" message="global-data-request" status="measured" evidence="korg-sysex measured_requests_match_the_capture" {
    args device-id=0
    bytes "F0 42 40 00 01 37 01 00 00 0E F7"
}
test-vector "scene-read" message="read-block-request" reply=#true variant="scene" status="measured" evidence="BLE capture 2026-10-20: header 01 05 00 40, 560-byte scene" {
    args device-id=0
    data "data" "54 52 41 4B 54 4F 52 20 20 20 20 20 01 FF FF FF 00 00 0D 00 7F FF FF FF 00 00 0E 00 7F FF FF FF 00 00 0F 00 7F FF FF FF 00 00 10 00 7F FF FF FF 00 00 11 00 7F FF FF FF 00 00 12 00 7F FF FF FF 00 00 13 00 7F FF FF FF 00 00 14 00 7F FF FF FF 00 00 02 00 7F FF FF FF 00 00 03 00 7F FF FF FF 00 00 04 00 7F FF FF FF 00 00 05 00 7F FF FF FF 00 00 06 00 7F FF FF FF 00 00 08 00 7F FF FF FF 00 00 09 00 7F FF FF FF 00 00 0C 00 7F FF FF FF 00 00 1D 00 7F 00 FF FF 00 00 1E 00 7F 00 FF FF 00 00 1F 00 7F 00 FF FF 00 00 21 00 7F 00 FF FF 00 00 22 00 7F 00 FF FF 00 00 23 00 7F 00 FF FF 00 00 24 00 7F 00 FF FF 00 00 25 00 7F 00 FF FF 00 00 15 00 7F 00 FF FF 00 00 16 00 7F 00 FF FF 00 00 17 00 7F 00 FF FF 00 00 18 00 7F 00 FF FF 00 00 19 00 7F 00 FF FF 00 00 1A 00 7F 00 FF FF 00 00 1B 00 7F 00 FF FF 00 00 1C 00 7F 00 FF FF 00 00 26 00 7F 00 FF FF 00 00 27 00 7F 00 FF FF 00 00 28 00 7F 00 FF FF 00 00 29 00 7F 00 FF FF 00 00 2A 00 7F 00 FF FF 00 00 2B 00 7F 00 FF FF 00 00 2C 00 7F 00 FF FF 00 00 2D 00 7F 00 FF FF 00 00 2E 00 7F 00 FF FF 00 00 2F 00 7F 00 FF FF 00 00 30 00 7F 00 FF FF 00 00 31 00 7F 00 FF FF 00 00 32 00 7F 00 FF FF 00 00 33 00 7F 00 FF FF 00 00 34 00 7F 00 FF FF 00 00 35 00 7F 00 FF FF 00 00 50 00 7F 00 FF FF 00 00 3F 00 7F 00 FF FF 00 00 51 00 7F 00 FF FF 00 00 3A 00 7F 00 FF FF 00 00 3B 00 7F 00 FF FF 00 00 36 00 7F 00 FF FF 00 00 3E 00 7F 00 FF FF 00 00 37 00 7F 00 FF FF 00 00 38 00 7F 00 FF FF 00 00 39 00 7F 00 FF FF 00 00 3C 00 7F 00 FF FF 00 00 3D 00 7F 00 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF 00 00 02 51 54 55 56 00 7F FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF"
    bytes "F0 42 40 00 01 37 01 05 00 40 00 54 52 41 4B 54 4F 52 40 20 20 20 20 20 01 7F 03 7F 7F 00 00 0D 00 7F 07 7F 7F 7F 00 00 0E 00 0E 7F 7F 7F 7F 00 00 0F 1C 00 7F 7F 7F 7F 00 00 38 10 00 7F 7F 7F 7F 00 70 00 11 00 7F 7F 7F 7F 60 00 00 12 00 7F 7F 7F 41 7F 00 00 13 00 7F 7F 03 7F 7F 00 00 14 00 7F 07 7F 7F 7F 00 00 02 00 0E 7F 7F 7F 7F 00 00 03 1C 00 7F 7F 7F 7F 00 00 38 04 00 7F 7F 7F 7F 00 70 00 05 00 7F 7F 7F 7F 60 00 00 06 00 7F 7F 7F 41 7F 00 00 08 00 7F 7F 03 7F 7F 00 00 09 00 7F 07 7F 7F 7F 00 00 0C 00 0E 7F 7F 7F 7F 00 00 1D 18 00 7F 00 7F 7F 00 00 30 1E 00 7F 00 7F 7F 00 60 00 1F 00 7F 00 7F 7F 40 00 00 21 00 7F 00 7F 01 7F 00 00 22 00 7F 00 03 7F 7F 00 00 23 00 7F 06 00 7F 7F 00 00 24 00 0C 7F 00 7F 7F 00 00 25 18 00 7F 00 7F 7F 00 00 30 15 00 7F 00 7F 7F 00 60 00 16 00 7F 00 7F 7F 40 00 00 17 00 7F 00 7F 01 7F 00 00 18 00 7F 00 03 7F 7F 00 00 19 00 7F 06 00 7F 7F 00 00 1A 00 0C 7F 00 7F 7F 00 00 1B 18 00 7F 00 7F 7F 00 00 30 1C 00 7F 00 7F 7F 00 60 00 26 00 7F 00 7F 7F 40 00 00 27 00 7F 00 7F 01 7F 00 00 28 00 7F 00 03 7F 7F 00 00 29 00 7F 06 00 7F 7F 00 00 2A 00 0C 7F 00 7F 7F 00 00 2B 18 00 7F 00 7F 7F 00 00 30 2C 00 7F 00 7F 7F 00 60 00 2D 00 7F 00 7F 7F 40 00 00 2E 00 7F 00 7F 01 7F 00 00 2F 00 7F 00 03 7F 7F 00 00 30 00 7F 06 00 7F 7F 00 00 31 00 0C 7F 00 7F 7F 00 00 32 18 00 7F 00 7F 7F 00 00 30 33 00 7F 00 7F 7F 00 60 00 34 00 7F 00 7F 7F 40 00 00 35 00 7F 00 7F 01 7F 00 00 50 00 7F 00 03 7F 7F 00 00 3F 00 7F 06 00 7F 7F 00 00 51 00 0C 7F 00 7F 7F 00 00 3A 18 00 7F 00 7F 7F 00 00 30 3B 00 7F 00 7F 7F 00 60 00 36 00 7F 00 7F 7F 40 00 00 3E 00 7F 00 7F 01 7F 00 00 37 00 7F 00 03 7F 7F 00 00 38 00 7F 06 00 7F 7F 00 00 39 00 0C 7F 00 7F 7F 00 00 3C 18 00 7F 00 7F 7F 00 00 70 3D 00 7F 00 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 01 7F 00 00 02 51 54 55 78 56 00 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F F7"
}
test-vector "commit-scene-1" message="commit-scene" status="measured" evidence="korg-sysex measured_write_frames_match_the_capture" {
    args device-id=0 scene=1
    bytes "F0 42 40 00 01 37 02 00 00 11 01 F7"
}
test-vector "commit-ack" message="commit-scene" reply=#true variant="ack" status="measured" evidence="korg-sysex measured_write_frames_match_the_capture" {
    args device-id=0 status=0x21
    bytes "F0 42 40 00 01 37 01 00 00 21 F7"
}
// The whole 560-byte scene from the scene-read capture, written back: the
// length (01 05 00 = 641) comes from the block size, as captured in
// korg-sysex measured_write_frames_match_the_capture. (The earlier vector
// put that captured header on a 4-byte payload, a length the device would
// reject; computing `{len}` exposed it.)
test-vector "scene-write" message="scene-write" status="decoded" evidence="korg-sysex measured_write_frames_match_the_capture (header); payload from the scene-read capture" {
    args device-id=0
    data "data" "54 52 41 4B 54 4F 52 20 20 20 20 20 01 FF FF FF 00 00 0D 00 7F FF FF FF 00 00 0E 00 7F FF FF FF 00 00 0F 00 7F FF FF FF 00 00 10 00 7F FF FF FF 00 00 11 00 7F FF FF FF 00 00 12 00 7F FF FF FF 00 00 13 00 7F FF FF FF 00 00 14 00 7F FF FF FF 00 00 02 00 7F FF FF FF 00 00 03 00 7F FF FF FF 00 00 04 00 7F FF FF FF 00 00 05 00 7F FF FF FF 00 00 06 00 7F FF FF FF 00 00 08 00 7F FF FF FF 00 00 09 00 7F FF FF FF 00 00 0C 00 7F FF FF FF 00 00 1D 00 7F 00 FF FF 00 00 1E 00 7F 00 FF FF 00 00 1F 00 7F 00 FF FF 00 00 21 00 7F 00 FF FF 00 00 22 00 7F 00 FF FF 00 00 23 00 7F 00 FF FF 00 00 24 00 7F 00 FF FF 00 00 25 00 7F 00 FF FF 00 00 15 00 7F 00 FF FF 00 00 16 00 7F 00 FF FF 00 00 17 00 7F 00 FF FF 00 00 18 00 7F 00 FF FF 00 00 19 00 7F 00 FF FF 00 00 1A 00 7F 00 FF FF 00 00 1B 00 7F 00 FF FF 00 00 1C 00 7F 00 FF FF 00 00 26 00 7F 00 FF FF 00 00 27 00 7F 00 FF FF 00 00 28 00 7F 00 FF FF 00 00 29 00 7F 00 FF FF 00 00 2A 00 7F 00 FF FF 00 00 2B 00 7F 00 FF FF 00 00 2C 00 7F 00 FF FF 00 00 2D 00 7F 00 FF FF 00 00 2E 00 7F 00 FF FF 00 00 2F 00 7F 00 FF FF 00 00 30 00 7F 00 FF FF 00 00 31 00 7F 00 FF FF 00 00 32 00 7F 00 FF FF 00 00 33 00 7F 00 FF FF 00 00 34 00 7F 00 FF FF 00 00 35 00 7F 00 FF FF 00 00 50 00 7F 00 FF FF 00 00 3F 00 7F 00 FF FF 00 00 51 00 7F 00 FF FF 00 00 3A 00 7F 00 FF FF 00 00 3B 00 7F 00 FF FF 00 00 36 00 7F 00 FF FF 00 00 3E 00 7F 00 FF FF 00 00 37 00 7F 00 FF FF 00 00 38 00 7F 00 FF FF 00 00 39 00 7F 00 FF FF 00 00 3C 00 7F 00 FF FF 00 00 3D 00 7F 00 FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF 00 00 02 51 54 55 56 00 7F FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF FF"
    bytes "F0 42 40 00 01 37 01 05 00 40 00 54 52 41 4B 54 4F 52 40 20 20 20 20 20 01 7F 03 7F 7F 00 00 0D 00 7F 07 7F 7F 7F 00 00 0E 00 0E 7F 7F 7F 7F 00 00 0F 1C 00 7F 7F 7F 7F 00 00 38 10 00 7F 7F 7F 7F 00 70 00 11 00 7F 7F 7F 7F 60 00 00 12 00 7F 7F 7F 41 7F 00 00 13 00 7F 7F 03 7F 7F 00 00 14 00 7F 07 7F 7F 7F 00 00 02 00 0E 7F 7F 7F 7F 00 00 03 1C 00 7F 7F 7F 7F 00 00 38 04 00 7F 7F 7F 7F 00 70 00 05 00 7F 7F 7F 7F 60 00 00 06 00 7F 7F 7F 41 7F 00 00 08 00 7F 7F 03 7F 7F 00 00 09 00 7F 07 7F 7F 7F 00 00 0C 00 0E 7F 7F 7F 7F 00 00 1D 18 00 7F 00 7F 7F 00 00 30 1E 00 7F 00 7F 7F 00 60 00 1F 00 7F 00 7F 7F 40 00 00 21 00 7F 00 7F 01 7F 00 00 22 00 7F 00 03 7F 7F 00 00 23 00 7F 06 00 7F 7F 00 00 24 00 0C 7F 00 7F 7F 00 00 25 18 00 7F 00 7F 7F 00 00 30 15 00 7F 00 7F 7F 00 60 00 16 00 7F 00 7F 7F 40 00 00 17 00 7F 00 7F 01 7F 00 00 18 00 7F 00 03 7F 7F 00 00 19 00 7F 06 00 7F 7F 00 00 1A 00 0C 7F 00 7F 7F 00 00 1B 18 00 7F 00 7F 7F 00 00 30 1C 00 7F 00 7F 7F 00 60 00 26 00 7F 00 7F 7F 40 00 00 27 00 7F 00 7F 01 7F 00 00 28 00 7F 00 03 7F 7F 00 00 29 00 7F 06 00 7F 7F 00 00 2A 00 0C 7F 00 7F 7F 00 00 2B 18 00 7F 00 7F 7F 00 00 30 2C 00 7F 00 7F 7F 00 60 00 2D 00 7F 00 7F 7F 40 00 00 2E 00 7F 00 7F 01 7F 00 00 2F 00 7F 00 03 7F 7F 00 00 30 00 7F 06 00 7F 7F 00 00 31 00 0C 7F 00 7F 7F 00 00 32 18 00 7F 00 7F 7F 00 00 30 33 00 7F 00 7F 7F 00 60 00 34 00 7F 00 7F 7F 40 00 00 35 00 7F 00 7F 01 7F 00 00 50 00 7F 00 03 7F 7F 00 00 3F 00 7F 06 00 7F 7F 00 00 51 00 0C 7F 00 7F 7F 00 00 3A 18 00 7F 00 7F 7F 00 00 30 3B 00 7F 00 7F 7F 00 60 00 36 00 7F 00 7F 7F 40 00 00 3E 00 7F 00 7F 01 7F 00 00 37 00 7F 00 03 7F 7F 00 00 38 00 7F 06 00 7F 7F 00 00 39 00 0C 7F 00 7F 7F 00 00 3C 18 00 7F 00 7F 7F 00 00 70 3D 00 7F 00 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 01 7F 00 00 02 51 54 55 78 56 00 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F 7F F7"
}
