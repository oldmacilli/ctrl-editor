// Faderfox UC4 (micromodul UC4) universal MIDI controller.
// Evidence repository: oldmacilli/Faderfox_UC4 (private; findings/ and the
// tools that made them). Captures and vendor files stay in the owner's
// local analysis archive.
//
// Evidence:
//   manual    "UC4 Manual V03": controls, edit and setup mode, factory settings
//   quick     "UC4 Schnellstartanleitung" (German quick start)
//   update    "UC4 update": firmware update procedure
//   firmware  UC4 V0205.syx (firmware 02.05): its container read byte for
//             byte; the dump format, the stored layout and the value codes
//             decoded from its code (dump sender and receiver, setup loader,
//             MIDI learn)
//   unit      the owner's unit, firmware 02.03, 2026-10-28: ioreg, CoreMIDI
//             port names, an all-setups dump (SndA, 430 records), a
//             current-setup dump (Sndc, 22 records) and control moves
//             (capture 2026-10-28-a)
//
// `measured` = seen on that unit; `decoded` = read from the 02.05 code and
// not contradicted by it; `inferred` = from the manual.
//
// What the device offers:
//   - a setup dump as one long SysEx that the user starts on the device
//     (setup mode, encoder 4 "Sndc": the current setup; encoder 8 "SndA":
//     all setups). There is no request message: the editor listens.
//   - the same format back into the device after the user arms receive
//     (setup mode, encoder 7 "rEc", then "rc00"). A one-setup dump lands in
//     whichever setup is selected, whatever setup it came from (measured:
//     written to SE16, read back, restored byte for byte).
//   - no identity reply: the SysEx receiver takes only the records below
//     and ignores other bytes (decoded).
cdl "0.1"

device "faderfox.uc4" {
    vendor "Faderfox"
    model "UC4"
    aka "micromodul UC4"
    manual "UC4 Manual V03; UC4 Schnellstartanleitung; UC4 update"
}

identify {
    // bcdDevice is 0 on firmware 02.03: it does not carry the version.
    usb vid=0x2256 pid=0x2004 bcd=0x0000 status="measured" evidence="unit: ioreg 2026-10-28 (vendor \"Faderfox\", product \"Faderfox UC4\", bcdUSB 0x0110, no serial number)"
    midi-port match="Faderfox UC4" direction="both" status="measured" evidence="unit: CoreMIDI, one input and one output of that name"
}

// USB MIDI, class compliant, one port each way. The device sends a dump to
// USB and DIN at once; the manual warns against receiving on both at the
// same time. `sysex-limit` only cuts the host's writes (CDL §8.2); the
// device still sees one SysEx. The values are the KORG transports'.
transport "usb" kind="midi" role="config" port-match="Faderfox UC4" sysex-limit=256 segment-delay=5 status="measured" evidence="unit: CoreMIDI port names; dumps arrive on it"
// 5-pin DIN through the enclosed 3.5 mm adapter cable; no port of its own
// on the host, so it is reached through the user's interface.
transport "din" kind="midi" role="performance" status="inferred" evidence="manual 'Package contents', 'Routing'"

types {
    int "channel" storage="u7" range="0..=15" display="{v + 1}" parse="{v - 1}" status="decoded" evidence="firmware: low nibble of the stored byte; manual Ch01..Ch16"
    // Display texts are the device's. Codes from the firmware's MIDI learn:
    // CC sets 2, program change 3, pitch bend 5, aftertouch 6; the other
    // three follow the manual's order.
    enum "encoder-type" status="decoded" evidence="firmware: MIDI learn; out of range loads as 2" {
        value 0 "CCr1 relative 1/127" status="inferred" evidence="manual order"
        value 1 "CCr2 relative 63/65" status="inferred" evidence="manual order"
        value 2 "CCAb absolute 7 bit"
        value 3 "PrGC program change"
        value 4 "CCAh 14 bit MSB/LSB" status="inferred" evidence="manual order"
        value 5 "Pbnd pitch bend"
        value 6 "AFtt aftertouch"
    }
    // Push buttons and green buttons.
    enum "button-type" status="decoded" evidence="firmware: MIDI learn (note 1, CC 2, program 3, aftertouch 4); out of range loads as 2" {
        value 0 "OFF" status="inferred" evidence="manual order"
        value 1 "notE note"
        value 2 "CC control change"
        value 3 "PrGC program change"
        value 4 "AFtt aftertouch"
    }
    enum "fader-type" status="decoded" evidence="firmware: MIDI learn; out of range loads as 0" {
        value 0 "CCAb absolute 7 bit"
        value 1 "PrGC program change"
        value 2 "Pbnd pitch bend"
        value 3 "AFtt aftertouch"
    }
    enum "encoder-mode" status="inferred" evidence="manual order; out of range loads as 3, factory Acc3" {
        value 0 "Acc0 no acceleration"
        value 1 "Acc1 low"
        value 2 "Acc2 middle"
        value 3 "Acc3 max"
    }
    // The manual lists SnAP first; the firmware shows "JMP" for 0.
    enum "fader-mode" status="measured" evidence="unit: 0 on setups 1..16 (factory jump), 1 on 17/18 (factory snap); firmware: the display text" {
        value 0 "JMP jump"
        value 1 "SnAP snap"
    }
    enum "button-mode" status="inferred" evidence="manual order; out of range loads as 0" {
        value 0 "btn momentary"
        value 1 "toGL toggle"
    }
    enum "display" status="inferred" evidence="manual order; out of range loads as 1 (Std)" {
        value 0 "OFF"
        value 1 "Std 0..127"
        value 2 "bPoL -63..63"
    }
    // The same stored slot on a green button: its LED.
    enum "led" status="inferred" evidence="manual order; out of range loads as 1 (Std)" {
        value 0 "OFF"
        value 1 "Std"
        value 2 "EXt external only"
    }
    // Rou3 is not in the manual's list; the firmware accepts 0..=6.
    enum "routing" status="inferred" evidence="manual 'Routing'; firmware loads values >= 7 as 5" {
        value 0 "Rou0 no routing"
        value 1 "Rou1 USB in to MIDI out"
        value 2 "Rou2 MIDI in to MIDI out"
        value 4 "Rou4 MIDI in to USB out"
        value 5 "Rou5 MIDI in to USB out + USB in to MIDI out"
        value 6 "Rou6 MIDI in to MIDI out + MIDI in to USB out"
    }
    // Tag 2 of the dump header. 1 is the firmware file's.
    enum "dump-kind" status="decoded" evidence="firmware: the receiver takes 2 and 3; the update file carries 1" {
        value 1 "firmware"
        value 2 "current setup (Sndc)"
        value 3 "all setups (SndA)"
    }
    enum "name-char" status="measured" evidence="unit: SndA factory group names (GrP1..8, Snd1..4, traC, RAC, PAn, GLOb); the display order 0..38 read on the unit with Shift + encoder 1 in edit mode; E 14, N 21, X 30, = 37 confirmed by SndA (2026-10-28, 02.05). N may be M and X looks like H on the display" {
        value 0 "0"
        value 1 "1"
        value 2 "2"
        value 3 "3"
        value 4 "4"
        value 5 "5"
        value 6 "6"
        value 7 "7"
        value 8 "8"
        value 9 "9"
        value 10 "A"
        value 11 "b"
        value 12 "C"
        value 13 "d"
        value 14 "E"
        value 15 "F"
        value 16 "G"
        value 17 "H"
        value 18 "I"
        value 19 "J"
        value 20 "L"
        value 21 "N"
        value 22 "n"
        value 23 "o"
        value 24 "P"
        value 25 "q"
        value 26 "r"
        value 27 "S"
        value 28 "t"
        value 29 "U"
        value 30 "X"
        value 31 "Y"
        value 32 "Z"
        value 33 "-"
        value 34 "_"
        value 35 "'"
        value 36 "\""
        value 37 "="
        value 38 " "
    }
}

// ---- Stored data -------------------------------------------------------
//
// A setup lives in three regions of the device's memory. The dump names
// each 32- or 64-byte chunk by its address (tag 9 high, tag 10 low):
//
//   names    0x1480 + 32 * s     32 bytes   one chunk
//   fader9   0x1700 + 64 * s     64 bytes   one chunk
//   controls 0x1C00 + 1280 * s   1280 bytes twenty chunks of 64
//
// s = setup 0..=17 (SE01..SE18). An all-setups dump sends every 64-byte
// chunk from 0x1480 to 0x7FC0, which also carries the copy memory and
// regions not decoded yet. The driver below maps chunks to blocks.

// Controls: 20 planes of 64 bytes. A plane holds one property of one kind
// of control for the 8 groups: byte 8 * group + n. Encoders and their push
// buttons follow the encoder group, green buttons and faders the
// fader/button group (firmware: MIDI learn).
// Measured: setups 2..16 of the owner's unit match the manual's factory
// table byte for byte under this layout (numbers, ranges, types, modes,
// channel = setup), setups 17 and 18 differ as the Live setups should, and
// setup 1 carries the owner's edits.
block "controls" address=0x1C00 size=1280 chunk=64 count=18 names="SE01 SE02 SE03 SE04 SE05 SE06 SE07 SE08 SE09 SE10 SE11 SE12 SE13 SE14 SE15 SE16 SE17 SE18" status="measured" evidence="unit: SndA 2026-10-28 against the manual's factory table; firmware: setup loader" {
    array "group" count=8 stride=8 {
        array "encoder" count=8 stride=1 {
            field "channel" offset=0 bits="0..=3" type="channel"
            field "type" offset=0 bits="4..=7" type="encoder-type"
            field "number" offset=64 type="u7" note="CC or note number; 14 bit: MSB 0..31, LSB = number + 32"
            field "lower" offset=128 type="u7"
            field "upper" offset=192 type="u7"
            field "display" offset=256 bits="0..=3" type="display"
            field "mode" offset=256 bits="4..=7" type="encoder-mode"
        }
        array "push" count=8 offset=320 stride=1 {
            field "channel" offset=0 bits="0..=3" type="channel"
            field "type" offset=0 bits="4..=7" type="button-type"
            field "number" offset=64 type="u7"
            field "lower" offset=128 type="u7"
            field "upper" offset=192 type="u7"
            // stored and checked like the others; the manual shows no
            // display setting for push buttons
            field "display" offset=256 bits="0..=3" type="display" status="unknown"
            field "mode" offset=256 bits="4..=7" type="button-mode"
        }
        array "button" count=8 offset=640 stride=1 {
            field "channel" offset=0 bits="0..=3" type="channel"
            field "type" offset=0 bits="4..=7" type="button-type"
            field "number" offset=64 type="u7"
            field "lower" offset=128 type="u7"
            field "upper" offset=192 type="u7"
            field "led" offset=256 bits="0..=3" type="led"
            field "mode" offset=256 bits="4..=7" type="button-mode"
        }
        array "fader" count=8 offset=960 stride=1 {
            field "channel" offset=0 bits="0..=3" type="channel"
            field "type" offset=0 bits="4..=7" type="fader-type"
            field "number" offset=64 type="u7"
            field "lower" offset=128 type="u7"
            field "upper" offset=192 type="u7"
            field "display" offset=256 bits="0..=3" type="display"
            field "mode" offset=256 bits="4..=7" type="fader-mode"
        }
    }
}

// Fader 9 (the crossfader), five bytes per fader/button group. Bytes
// 40..63 of the chunk are not read by the firmware's loader.
block "fader9" address=0x1700 size=64 chunk=64 count=18 status="measured" evidence="unit: SndA, CC 112 in every group of setups 1..16, 0x30 = CC 48 on 17/18 (manual); firmware: setup loader reads 40 bytes; bytes 40..63 are FF on the unit" {
    array "group" count=8 stride=5 {
        field "channel" offset=0 bits="0..=3" type="channel"
        field "type" offset=0 bits="4..=7" type="fader-type"
        field "number" offset=1 type="u7"
        field "lower" offset=2 type="u7"
        field "upper" offset=3 type="u7"
        field "display" offset=4 bits="0..=3" type="display"
        field "mode" offset=4 bits="4..=7" type="fader-mode"
    }
}

// Encoder group names, 4 characters each, in the device's own character
// codes. Measured from the factory names: digits 0..9 are 0x00..0x09,
// A 0x0A, b 0x0B, C 0x0C, d 0x0D, G 0x10, L 0x14, n 0x16, o 0x17, P 0x18,
// r 0x1A, S 0x1B, t 0x1C, blank 0x26. The letters look alphabetic from 0x0A
// without K (L is 0x14), but only these codes are seen.
block "names" address=0x1480 size=32 chunk=32 count=18 status="measured" evidence="unit: SndA: GrP1..GrP8 on setups 1..16, Snd1..GLOb on 17/18" {
    array "group" count=8 stride=4 {
        array "char" count=4 stride=1 type="name-char"
    }
}

// Everything an all-setups dump carries, 430 chunks of 64 bytes: the three
// blocks above plus the copy memory and the unused ranges (FF on the unit).
// A restore sends it as it came.
block "dump-area" address=0x1480 size=27520 chunk=64 status="measured" evidence="unit: SndA covers 0x1480..0x7FFF without a gap"

// Kept outside every dump: the editor can neither read nor write it.
block "global" status="decoded" evidence="firmware: start-up reads both bytes; no dump covers them" {
    field "setup" offset=0 type="u8" range="0..=17" note="current setup; 18 and up reset all setups to factory data"
    field "routing" offset=1 type="routing"
}

param "controls.*.group.*.encoder.*.type" label="Type" group="Encoder" ui="combo"
param "controls.*.group.*.encoder.*.channel" label="Channel" group="Encoder" ui="spin"
param "controls.*.group.*.fader.*.mode" label="Snap / jump" group="Fader" ui="combo"
param "controls.*.group.*.button.*.led" label="LED" group="Button" ui="combo"

// ---- Setup dump --------------------------------------------------------
//
// One SysEx, no manufacturer id. Every value is a record of three bytes,
// `4t 2h 1l`: tag t, then the value's high and low nibble (CDL §8.1,
// `nib3`). The device ignores any byte whose high nibble is not 4, 2 or 1,
// so zeros pad.
//
//   F0 00 00 00
//   41 20 16          tag 1: device 6 (UC4); the receiver rejects others
//   42 2h 1l          tag 2: dump kind
//   43 2h 1l 44 2h 1l tags 3, 4: the sender's firmware version (02 03 on
//                     the unit); the receiver stores them, checks nothing
//   chunks            the records below, 22 (Sndc) or 430 (SndA)
//   4F 20 16 F7       tag 15: end, value 6
//
// Measured on 02.03: both dumps, every chunk's sum, the addresses (Sndc of
// setup 1: 0x1480, 0x1700, 0x1C00..0x20C0; SndA: 0x1480..0x7FC0 without a
// gap).
//
// Receive, measured on 02.03 (write test 2026-10-28): a one-setup dump
// (kind 2, 22 chunks) sent at full USB speed is stored into the selected
// setup; the display then shows "SE.." and stays in setup mode. A kind-3
// dump of one chunk was accepted without "Err" (the unit left setup mode)
// but nothing was stored, so kind-3 writes stay unconfirmed. Decoded only:
// the sum is checked over the size the address implies (32 below 0x1700,
// else 64), and addresses below 0x1480 are refused.
//
// Two 02.03 quirks seen: the display shows nothing for Sndc although the
// dump goes out; and once SndA reported setup 1 different from Sndc and
// from the controls (the working copy), until setup mode was left, after
// which SndA matched the working copy. So leaving setup mode can store the
// working copy of the current setup: dump before leaving it.

// One chunk: address, 32 or 64 data bytes, their 16-bit sum, ten zero
// records of padding.
pattern "dump-chunk" "{addr-hi:nib3(9)} {addr-lo:nib3(10)} {data:nib3-bytes(13)} {sum-hi:nib3(11)} {sum-lo:nib3(12)} 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00 00"

// What the device sends after Sndc or SndA.
message "dump" transport="usb" status="measured" evidence="unit: SndA and Sndc 2026-10-28 (firmware 02.03); firmware 02.05: dump sender" {
    arg "kind" type="dump-kind"
    reply "F0 00 00 00 41 20 16 {kind:nib3(2)} {fw-major:nib3(3)} {fw-minor:nib3(4)} {chunks*} 4F 20 16 F7"
    records "chunks" pattern="dump-chunk" address="(addr-hi << 8) | addr-lo" data="data" {
        derive "addr-hi" "address >> 8"
        derive "addr-lo" "address & 0xFF"
        derive "sum-hi" "(data.sum >> 8) & 0xFF"
        derive "sum-lo" "data.sum & 0xFF"
    }
}

// One setup into the device, after the user selects the target setup and
// arms receive (rEc). The receiver maps the chunks onto the selected setup.
message "dump-out" transport="usb" kind="write" status="measured" evidence="unit, firmware 02.03, 2026-10-28: SE16 patched (4 bytes), read back by SndA and Sndc, restored; final SndA byte-identical to the one before" {
    arg "kind" range="2..=2"
    send "F0 00 00 00 41 20 16 {kind:nib3(2)} {fw-major:nib3(3)} {fw-minor:nib3(4)} {chunks:raw} 4F 20 16 F7"
    records "chunks" pattern="dump-chunk" address="(addr-hi << 8) | addr-lo" data="data" {
        derive "addr-hi" "address >> 8"
        derive "addr-lo" "address & 0xFF"
        derive "sum-hi" "(data.sum >> 8) & 0xFF"
        derive "sum-lo" "data.sum & 0xFF"
    }
}

// All setups into the device (kind 3: each chunk at its address), paced.
// Measured: a full dump of 430 chunks from 0x1480, 20 ms after each, is
// stored (SE16 renamed and restored this way); an unpaced dump of one chunk
// was ignored on 02.03.
message "dump-out-all" transport="usb" kind="write" status="measured" evidence="unit, firmware 02.03, 2026-10-28: a full paced dump stored byte for byte, then the backup restored the same way; a one-chunk unpaced dump was ignored. 02.05: the backup restored through restore-all; one chunk (paced or not) and a full unpaced dump are stored too, so pace=20 is a margin for 02.03, not needed on 02.05" {
    arg "kind" range="3..=3"
    send "F0 00 00 00 41 20 16 {kind:nib3(2)} {fw-major:nib3(3)} {fw-minor:nib3(4)} {chunks:raw} 4F 20 16 F7"
    // 20 ms after each chunk: measured to work; whether less would do is
    // not known
    records "chunks" pattern="dump-chunk" address="(addr-hi << 8) | addr-lo" data="data" pace=20 {
        derive "addr-hi" "address >> 8"
        derive "addr-lo" "address & 0xFF"
        derive "sum-hi" "(data.sum >> 8) & 0xFF"
        derive "sum-lo" "data.sum & 0xFF"
    }
}

// ---- By hand (CDL §17) -------------------------------------------------
// What the user presses on the UC4 (manual "Controller mode", "Edit mode",
// "Setup mode"). Dumps start on the device and every write needs receive
// armed on it, so the procedures below guide through both; the edit rules
// change a setup on the device itself, without a dump.

hands status="inferred" evidence="manual 'Controller mode', 'Edit mode', 'Setup mode'" {
    key "shift" label="Shift"
    key "edit" label="Edit"
    key "encoder{n}" range="1..=8" label="encoder {n}"
    key "push{n}" range="1..=8" label="encoder {n}'s push button"
    key "green{n}" range="1..=8" label="green button {n}"
}

recipe "setup-mode" {
    press "edit" with="shift" times=2 hint="Setup mode: the red setup LED lights. Skip it if the LED is lit already."
}

// "Setup and routing selection (encoder 1 and 2) works immediately."
recipe "select-setup" args="s" {
    turn "encoder1" to="SE{s + 1:02}"
}

recipe "leave" {
    press "edit" hint="Without Shift."
}

// Edit mode on setup s: select it in setup mode, leave, enter edit mode.
recipe "edit-setup" args="s" {
    do "setup-mode"
    do "select-setup" s="{s}"
    do "leave" hint="Leaves setup mode; SE{s + 1:02} stays selected."
    press "edit" with="shift" hint="Edit mode: the red edit LED lights."
}

recipe "leave-edit" {
    press "edit" hint="Leaves edit mode; the UC4 stores the setup."
}

// ---- Procedures (CDL §11) ----------------------------------------------
// The UC4 has no request message: every read is a dump the user starts on
// the device, and every write needs receive armed on the device. The guide
// steps say what to press; the engine waits for the dump.

// All setups, stored copy (SndA). Also the restore point of every write.
procedure "read-all" kind="read" transport="usb" status="measured" evidence="unit, firmware 02.03: SndA 2026-10-28" {
    do "setup-mode"
    hold "push8" until="running bars" hint="SndA: the display counts Sn00..Sn99. Stay in setup mode."
    await "dump" kind=3 timeout=300000
}

// The current setup (Sndc). On firmware 02.03 this is the working copy:
// read it before leaving setup mode, which stores the working copy.
procedure "read-setup" kind="read" transport="usb" status="measured" evidence="unit, firmware 02.03: Sndc 2026-10-28" {
    say "Stay in setup mode, on SE{setup + 1:02}."
    hold "push4" until="running bars" hint="Sndc; the display may show nothing. Do not leave setup mode yet."
    await "dump" kind=2 timeout=300000
}

// One setup from the document into setup `setup` (0-based; SE{setup + 1}).
// A backup of all setups comes first and is kept; then the user selects the
// setup and arms receive; then the write; then both copies are read back
// and compared. Leave setup mode only after the run has verified.
procedure "write-setup" kind="write" transport="usb" status="measured" evidence="unit, firmware 02.03 and 02.05, 2026-10-28: ctrl-cli run on SE16 (dAtA) and back on each; backups kept, read-backs byte-identical" {
    call "read-all"
    restore-point "names" "fader9" "controls"
    gate "confirm" text="This overwrites setup SE{setup + 1:02} on the UC4 (names, fader 9, all controls)."
    do "select-setup" s="{setup}" hint="Still in setup mode."
    hold "push7" until="rEc, then rc00" hint="Do not press Shift. Confirm when it shows rc00."
    send "dump-out" kind=2 fw-major="{fw-major}" fw-minor="{fw-minor}" records-from="names[setup] fader9[setup] controls[setup]"
    verify "read-all" compare="names[setup] fader9[setup] controls[setup]"
    verify "read-setup" compare="names[setup] fader9[setup] controls[setup]"
    say "Verified: SE{setup + 1:02} on the UC4 holds the document."
    do "leave" hint="Leaves setup mode."
}

// Restore all setups from the document (a backup dump): 430 chunks, paced.
// It overwrites all 18 setups and the copy memory.
procedure "restore-all" kind="write" transport="usb" status="measured" evidence="unit, firmware 02.03 and 02.05, 2026-10-28: run through ctrl-cli run with the backup loaded (--load dump=<file>) on each; backup kept, 430 paced chunks sent, read-back byte-identical to the backup" {
    call "read-all"
    restore-point "dump-area"
    gate "confirm" text="This overwrites ALL 18 setups on the UC4 (names, fader 9, all controls, the copy memory) with the backup."
    hold "push7" until="rEc, then rc00" hint="In setup mode; do not press Shift. Confirm when it shows rc00; the display then counts rc00..rc99 for about 10 seconds."
    send "dump-out-all" kind=3 fw-major="{fw-major}" fw-minor="{fw-minor}" records-from="dump-area"
    verify "read-all" compare="dump-area"
    say "Verified: all setups on the UC4 hold the backup."
    do "leave" hint="Leaves setup mode."
}

// ---- Edit mode (CDL §17.4) ---------------------------------------------
// One setup changed on the device: choose the group (Shift and an encoder
// push button for encoders, Shift and a green button for faders and green
// buttons), select the control with encoder 1, set its properties with
// encoders 2..8. Leaving edit mode stores the setup. Variables: s = setup
// 0..=17, g = group 0..=7, n = control 0..=7.

edit "controls" index="s" status="inferred" evidence="manual 'Edit mode'" {
    open { do "edit-setup" s="{s}"; }
    item "group.encoder" index="g n" {
        select {
            press "push{g + 1}" with="shift" hint="Encoder group {g + 1}."
            turn "encoder1" to="Enc{n + 1}"
        }
        field "display" { turn "encoder2" to="{v}" as="display"; }
        field "type" { turn "encoder3" to="{v}" as="encoder-type"; }
        field "mode" { turn "encoder4" to="{v}" as="encoder-mode"; }
        field "channel" { turn "encoder5" to="Ch{v + 1:02}"; }
        field "number" { turn "encoder6" to="n{v:03}"; }
        field "lower" { turn "encoder7" to="L{v:03}"; }
        field "upper" { turn "encoder8" to="U{v:03}"; }
    }
    // The manual shows no display setting for push buttons.
    item "group.push" index="g n" {
        select {
            press "push{g + 1}" with="shift" hint="Encoder group {g + 1}."
            turn "encoder1" to="Pbt{n + 1}"
        }
        field "type" { turn "encoder3" to="{v}" as="button-type"; }
        field "mode" { turn "encoder4" to="{v}" as="button-mode"; }
        field "channel" { turn "encoder5" to="Ch{v + 1:02}"; }
        field "number" { turn "encoder6" to="n{v:03}"; }
        field "lower" { turn "encoder7" to="L{v:03}"; }
        field "upper" { turn "encoder8" to="U{v:03}"; }
    }
    item "group.button" index="g n" {
        select {
            press "green{g + 1}" with="shift" hint="Fader/button group {g + 1}."
            turn "encoder1" to="btn{n + 1}"
        }
        field "led" { turn "encoder2" to="{v}" as="led"; }
        field "type" { turn "encoder3" to="{v}" as="button-type"; }
        field "mode" { turn "encoder4" to="{v}" as="button-mode"; }
        field "channel" { turn "encoder5" to="Ch{v + 1:02}"; }
        field "number" { turn "encoder6" to="n{v:03}"; }
        field "lower" { turn "encoder7" to="L{v:03}"; }
        field "upper" { turn "encoder8" to="U{v:03}"; }
    }
    item "group.fader" index="g n" {
        select {
            press "green{g + 1}" with="shift" hint="Fader/button group {g + 1}."
            turn "encoder1" to="FAd{n + 1}"
        }
        field "display" { turn "encoder2" to="{v}" as="display"; }
        field "type" { turn "encoder3" to="{v}" as="fader-type"; }
        field "mode" { turn "encoder4" to="{v}" as="fader-mode"; }
        field "channel" { turn "encoder5" to="Ch{v + 1:02}"; }
        field "number" { turn "encoder6" to="n{v:03}"; }
        field "lower" { turn "encoder7" to="L{v:03}"; }
        field "upper" { turn "encoder8" to="U{v:03}"; }
    }
    close { do "leave-edit"; }
}

edit "fader9" index="s" status="inferred" evidence="manual 'Edit mode': FAd9" {
    open { do "edit-setup" s="{s}"; }
    item "group" index="g" {
        select {
            press "green{g + 1}" with="shift" hint="Fader/button group {g + 1}."
            turn "encoder1" to="FAd9"
        }
        field "display" { turn "encoder2" to="{v}" as="display"; }
        field "type" { turn "encoder3" to="{v}" as="fader-type"; }
        field "mode" { turn "encoder4" to="{v}" as="fader-mode"; }
        field "channel" { turn "encoder5" to="Ch{v + 1:02}"; }
        field "number" { turn "encoder6" to="n{v:03}"; }
        field "lower" { turn "encoder7" to="L{v:03}"; }
        field "upper" { turn "encoder8" to="U{v:03}"; }
    }
    close { do "leave-edit"; }
}

// "Group names can be modified in edit mode by holding shift and turning
// encoder 1 to 4."
edit "names" index="s" status="inferred" evidence="manual 'Edit mode'; the character order measured (type name-char)" {
    open { do "edit-setup" s="{s}"; }
    item "group" index="g" {
        select { press "push{g + 1}" with="shift" hint="Encoder group {g + 1}."; }
        field "char" index="k" {
            turn "encoder{k + 1}" with="shift" to="{v}" as="name-char" hint="Character {k + 1} of the group name."
        }
    }
    close { do "leave-edit"; }
}

edit "global" status="inferred" evidence="manual 'Setup mode'" {
    open { do "setup-mode"; }
    field "setup" applies="v <= 17" { do "select-setup" s="{v}"; }
    field "routing" { turn "encoder2" to="{v}" as="routing"; }
    close { do "leave" hint="Leaving setup mode stores the routing."; }
}

// ---- Performance -------------------------------------------------------
// What the controls send (manual "Command type"). Nothing captured yet.
message "cc" transport="usb" status="measured" evidence="unit: encoder 1 CC 8, fader 1 CC 32, fader 9 CC 112 on channel 1 (capture 2026-10-28-a)" {
    arg "ch" range="0..=15"
    reply "{0xB0 + ch} {cc} {value}"
}
message "note-on" transport="usb" status="measured" evidence="unit: push button 1 90 00 7F, green button 1 90 40 7F" {
    arg "ch" range="0..=15"
    reply "{0x90 + ch} {note} {velocity}"
}
message "note-off" transport="usb" status="measured" evidence="unit: release sends 80 nn 00 (the lower value), not a note-on with velocity 0" {
    arg "ch" range="0..=15"
    reply "{0x80 + ch} {note} {velocity}"
}
message "program" transport="usb" status="inferred" evidence="manual: PrGC" {
    arg "ch" range="0..=15"
    reply "{0xC0 + ch} {program}"
}
message "pressure" transport="usb" status="inferred" evidence="manual: AFtt" {
    arg "ch" range="0..=15"
    reply "{0xD0 + ch} {value}"
}
message "pitch-bend" transport="usb" status="inferred" evidence="manual: Pbnd, 0..16383" {
    arg "ch" range="0..=15"
    reply "{0xE0 + ch} {value:u14le}"
}

// `type` names a command type per kind of control (the enums above), not a
// message: the mapping from type to message is the editor's, not data yet.
midi-map transport="usb" status="inferred" evidence="manual: every control by channel, type and number" {
    source "controls.group.encoder" count=64 kind="from-field" message="{type}" channel="{channel}"
    source "controls.group.push" count=64 kind="from-field" message="{type}" channel="{channel}"
    source "controls.group.button" count=64 kind="from-field" message="{type}" channel="{channel}"
    source "controls.group.fader" count=64 kind="from-field" message="{type}" channel="{channel}"
    source "fader9.group" count=8 kind="from-field" message="{type}" channel="{channel}"
}

// ---- Firmware update ---------------------------------------------------
// The update file is the same record format: tag 1 = 6, tag 2 = 1
// (firmware), tag 3/4 = the version (02 05 in V0205), tags 5..8 not
// decoded; 154 pages of 256 bytes (tag 9/10 page number, 256 x tag 13, a
// 16-bit check value in tags 11/12, 20 zero records), end 4F 20 16. The
// bootloader takes it; its page check is not reproduced (not a 16-bit sum,
// not a CRC-16), so the editor cannot build or check an image and does not
// update firmware. Users send the vendor's file with a SysEx tool.
message "firmware-file" transport="usb" kind="commit" status="unknown" evidence="update; firmware file container" {
    send "F0 00 00 00 41 20 16 42 20 11 {rest:raw} F7"
}

driver "faderfox-firmware" status="unknown" note="would check the page values; algorithm unknown"

firmware status="unknown" {
    image format="faderfox-syx" magic="F0 00 00 00 41 20 16 42 20 11" driver="faderfox-firmware"
    stage "transfer" kind="commit" {
        send "firmware-file"
    }
    recovery "Hold the black shift key while plugging in the USB cable and release it when the display lights up; after 3 seconds the display shows Ud00. Send the file again. On UdEr, stop the transfer, press shift briefly and wait for Ud00 before you repeat it. Reconnect the cable afterwards."
}

// ---- Panel -------------------------------------------------------------
// Positions are drawn, not measured: 8 push encoders, the 4-digit display,
// shift and edit, 8 green buttons, 8 faders and fader 9 (crossfader).
panel picture="720x420" source="drawn from the manual's control list, not to scale" status="inferred" {
    repeat "n" "1..=8" {
        control "enc{n}" kind="knob" label="Encoder {n}" group="Encoders" box="{20 + 80 * (n - 1)},20,50,50" bind="controls.group.encoder"
    }
    control "display" kind="meter" label="Display" group="Display" box="560,100,140,40"
    control "shift" kind="button" label="Shift" group="Keys" box="560,160,60,30"
    control "edit" kind="button" label="Edit" group="Keys" box="640,160,60,30"
    repeat "n" "1..=8" {
        control "btn{n}" kind="button" label="Button {n}" group="Buttons" box="{20 + 80 * (n - 1)},100,50,30" bind="controls.group.button"
    }
    repeat "n" "1..=8" {
        control "fad{n}" kind="fader" label="Fader {n}" group="Faders" box="{30 + 80 * (n - 1)},150,30,180" bind="controls.group.fader"
    }
    control "fad9" kind="fader" label="Fader 9" group="Faders" box="200,360,280,40" bind="fader9.group"
}

labels "en" source="manual 'Factory settings', 'Ableton Live mode'" status="inferred" {
    list "group-names-factory" {
        item 1 "GrP1"
        item 2 "GrP2"
        item 3 "GrP3"
        item 4 "GrP4"
        item 5 "GrP5"
        item 6 "GrP6"
        item 7 "GrP7"
        item 8 "GrP8"
    }
    list "group-names-live" {
        item 1 "Snd1"
        item 2 "Snd2"
        item 3 "Snd3"
        item 4 "Snd4"
        item 5 "traC"
        item 6 "RAC"
        item 7 "PAn"
        item 8 "GLOb"
    }
}

// ---- Test vectors (synthetic data in the measured format) --------------
// The frame of a dump into the device; the chunk bytes come from the
// records (ctrl-codec tests).
test-vector "dump-out-frame" message="dump-out" status="measured" evidence="unit: header and end of the sent one-setup dumps; chunk bytes synthetic" {
    args kind=2 fw-major=2 fw-minor=3
    data "chunks" "49 21 1C"
    bytes "F0 00 00 00 41 20 16 42 20 12 43 20 12 44 20 13 49 21 1C 4F 20 16 F7"
}
test-vector "dump-header" message="dump" reply=#true status="measured" evidence="unit: SndA header and end, body left out" {
    args kind=3 fw-major=2 fw-minor=3
    bytes "F0 00 00 00 41 20 16 42 20 13 43 20 12 44 20 13 00 00 4F 20 16 F7"
}
test-vector "cc-enc1" message="cc" reply=#true status="measured" evidence="unit: encoder 1, capture 2026-10-28-a" {
    args ch=0 cc=8 value=64
    bytes "B0 08 40"
}
